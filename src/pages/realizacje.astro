---
import Base from '../layouts/Base.astro';
import home from '../data/pages/home.json';
import projects from '../data/realizacje.json';
import { crumbs } from '../data/site';

// header/footer data from the home page, with "Realizacje" marked as the current page
const v = {
  ...home,
  navRest: home.navRest.map((l: any) => ({ ...l, cls: l.k === 'real' ? 'is-cur' : '', cur: l.k === 'real' ? 'page' : 'false' })),
  navLinks: home.navLinks.map((l: any) => ({ ...l, cls: l.k === 'real' ? 'is-cur' : '', cur: l.k === 'real' ? 'page' : 'false' })),
};
const filters = [
  ['all', 'Wszystkie'], ['site', 'Strona www'], ['shop', 'E-commerce'], ['other', 'Inne'],
].map(([k, label]) => ({ k, label, count: k === 'all' ? projects.length : projects.filter((p) => p.c === k).length }));
const ld = [
  crumbs([['Strona główna', '/'], ['Realizacje', '/realizacje/']]),
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Realizacje top.strony', url: 'https://topstrony.pl/realizacje/',
    hasPart: projects.map((p) => ({ '@type': 'CreativeWork', name: p.t, genre: p.l, about: p.ind || undefined })) },
];
---
<Base v={v} page="real" path="/realizacje/" jsonLd={ld}
  title="Realizacje – strony i sklepy internetowe | top.strony"
  description="35 stron firmowych, sklepów internetowych i portali, które zaprojektowaliśmy i wdrożyliśmy dla firm usługowych, produkcyjnych i e-commerce.">
  <main id="main" class="rz">
    <section class="rz-hero" aria-labelledby="real-h1">
      <div class="wrap">
        <p class="eyebrow h-in">Portfolio · {projects.length} projektów</p>
        <h1 id="real-h1" class="h h-in">Realizacje</h1>
        <p class="rz-lead h-in">Strony firmowe, sklepy internetowe i portale, które zaprojektowaliśmy i wdrożyliśmy dla firm usługowych, produkcyjnych i e-commerce.</p>
      </div>
    </section>

    <section class="rz-list" aria-label="Lista realizacji">
      <div class="wrap">
        <div class="rz-flt-wrap rv">
          <div class="flt-row" role="group" aria-label="Filtruj realizacje" data-filters>
            {filters.map((f, i) => (
              <button type="button" class:list={['flt', { 'is-on': i === 0 }]} data-f={f.k} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}<sup>{f.count}</sup></button>
            ))}
            <span class="flt-line" aria-hidden="true"></span>
          </div>
        </div>
        <div class="grid" data-grid>
          {projects.map((p, i) => (
            <article class="proj" data-c={p.c}>
              <a href="/kontakt/" class="proj-img" data-cursor="Zobacz" aria-label={`Zapytaj o podobny projekt: ${p.t}`}>
                <div class="proj-mask"><div class="proj-scrub">
                  <img src={p.img} alt={`${p.t} – realizacja top.strony`} width={p.w} height={p.h} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
                </div></div>
              </a>
              <div class="proj-txt">
                <div class="proj-meta"><span class="cat">{p.l}</span>{p.ind && <><span class="div" aria-hidden="true"></span><span>{p.ind}</span></>}</div>
                <h2 class="proj-h"><span class="proj-title">{p.t}</span></h2>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="rz-cta" aria-labelledby="cta-h">
      <div class="wrap">
        <h2 id="cta-h" class="h">Twoja firma może być następna</h2>
        <p class="rz-lead">Opowiedz nam o swoim projekcie. Wycenę dostaniesz w ciągu 24 godzin.</p>
        <div class="rz-ctas">
          <a href="/kontakt/" class="btn btn-g" data-magnetic>Bezpłatna wycena</a>
          <a href="tel:+48501784882" class="btn btn-o" data-magnetic>501 784 882</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .rz-hero { padding: 170px 0 70px; text-align: center; }
  .rz-hero h1 { margin: 0; font-size: clamp(64px, 12vw, 176px) !important; line-height: .92 !important; font-weight: 600; letter-spacing: -.05em; }
  .rz-lead { margin: 30px auto 0; max-width: 620px; font-size: 18px; line-height: 1.65; color: var(--muted); }
  .rz-list { padding: 0 0 150px; }
  .rz-flt-wrap { display: flex; justify-content: center; margin-bottom: 90px; }
  .flt-row { position: relative; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 44px; padding-bottom: 14px; }
  .flt { all: unset; cursor: pointer; font-family: Poppins, sans-serif; font-size: 22px; font-weight: 500; color: var(--muted); transition: color .3s ease; min-height: 44px; display: inline-flex; align-items: center; }
  .flt:hover, .flt.is-on { color: var(--ink); }
  .flt sup { font-family: Inter, sans-serif; font-size: 12px; font-weight: 600; color: var(--acc); margin-left: 6px; transform: translateY(-8px); }
  .flt:focus-visible { outline: 3px solid var(--acc); outline-offset: 4px; border-radius: 6px; }
  .flt-line { position: absolute; left: 0; bottom: 0; height: 2px; width: 60px; background: var(--acc); transition: transform .6s cubic-bezier(.77,0,.18,1), width .6s cubic-bezier(.77,0,.18,1); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 72px 40px; }
  .proj { min-width: 0; }
  .proj[hidden] { display: none; }
  .grid:not(.is-filtered) .proj:nth-child(3n+2) { margin-top: 90px; }
  .proj-img { position: relative; display: block; overflow: hidden; aspect-ratio: 43 / 30; border-radius: 6px; background: var(--surface-2); }
  .proj-mask { position: absolute; inset: 0; overflow: hidden; transition: clip-path 1.4s cubic-bezier(.77,0,.18,1); }
  :global(.js-anim) .proj:not(.in) .proj-mask { clip-path: inset(100% 0 0 0); }
  .proj-scrub { position: absolute; inset: -6% 0; will-change: transform; }
  .proj-scrub img { display: block; width: 100%; height: 100%; object-fit: cover; transform: scale(1.04); transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .proj:hover .proj-scrub img { transform: scale(1.12); }
  .proj-meta { margin-top: 22px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 13px; color: var(--muted); }
  .proj-meta .cat { color: var(--acc-t); font-weight: 600; }
  .proj-meta .div { width: 26px; height: 1px; background: var(--line-2); }
  .proj-h { margin: 0; font-size: inherit !important; line-height: inherit !important; font-weight: inherit; }
  .proj-title { display: inline-block; margin-top: 12px; color: var(--ink); font-family: Poppins, sans-serif; font-size: 26px; font-weight: 500; line-height: 1.25;
    background-image: linear-gradient(var(--acc), var(--acc)); background-size: 0 2px; background-repeat: no-repeat; background-position: 0 100%; transition: background-size .5s cubic-bezier(.2,.7,.2,1); }
  .proj:hover .proj-title { background-size: 100% 2px; }
  :global(.js-anim) .proj .proj-txt { opacity: 0; transform: translateY(24px); transition: opacity .9s ease .35s, transform .9s ease .35s; }
  :global(.js-anim) .proj.in .proj-txt { opacity: 1; transform: none; }
  .rz-cta { padding: 140px 0; border-top: 1px solid var(--line); text-align: center; background: radial-gradient(800px 420px at 50% 100%, var(--glow), transparent 70%); }
  .rz-cta h2 { margin: 0; letter-spacing: -.04em; }
  .rz-ctas { display: flex; gap: 12px; justify-content: center; margin-top: 38px; flex-wrap: wrap; }
  @media (max-width: 1000px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid:not(.is-filtered) .proj:nth-child(3n+2) { margin-top: 0; }
    .grid:not(.is-filtered) .proj:nth-child(2n) { margin-top: 70px; }
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 48px; }
    .grid:not(.is-filtered) .proj:nth-child(2n) { margin-top: 0; }
    .flt { font-size: 18px; }
    .flt-row { gap: 4px 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-anim) .proj .proj-txt { transform: none; opacity: 1; }
    :global(.js-anim) .proj:not(.in) .proj-mask { clip-path: none; }
  }
</style>

<script>
  const row = document.querySelector<HTMLElement>('[data-filters]');
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const line = row?.querySelector<HTMLElement>('.flt-line');
  const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.proj')) : [];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const moveLine = () => {
    const on = row?.querySelector<HTMLElement>('.flt.is-on');
    if (on && line) { line.style.width = on.offsetWidth + 'px'; line.style.transform = `translate3d(${on.offsetLeft}px,0,0)`; }
  };
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
  cards.forEach((c) => io.observe(c));
  row?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('.flt');
    if (!b || !grid) return;
    const f = b.dataset.f;
    row.querySelectorAll('.flt').forEach((x) => { x.classList.toggle('is-on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
    grid.classList.toggle('is-filtered', f !== 'all');
    const shown = cards.filter((c) => { const on = f === 'all' || c.dataset.c === f; c.hidden = !on; return on; });
    shown.forEach((c) => c.classList.add('in'));
    if (!reduce) shown.forEach((c, i) => c.animate([{ opacity: 0, transform: 'translateY(50px) scale(.96)' }, { opacity: 1, transform: 'none' }], { duration: 800, delay: i * 50, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'backwards' }));
    moveLine();
  });
  moveLine();
  window.addEventListener('resize', moveLine, { passive: true });
  document.fonts?.ready.then(moveLine);
  if (!reduce) {
    let tick = false;
    const scrub = () => {
      tick = false;
      const vh = window.innerHeight;
      grid?.querySelectorAll<HTMLElement>('.proj-scrub').forEach((s) => {
        const r = (s.parentNode as HTMLElement).getBoundingClientRect();
        if (r.bottom < -100 || r.top > vh + 100) return;
        s.style.transform = `translate3d(0,${((((r.top + r.height / 2) - vh / 2) / vh) * -8).toFixed(2)}%,0)`;
      });
    };
    window.addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(scrub); } }, { passive: true });
    scrub();
  }
</script>
