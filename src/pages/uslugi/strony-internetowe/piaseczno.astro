---
import Base from '../../../layouts/Base.astro';
import v from '../../../data/pages/srv-strony.json';
import { crumbs, faqLd, SITE, MAP_PLACE, mapEmbed } from '../../../data/site';
import '../../../styles/piaseczno.css';

const path = '/uslugi/strony-internetowe/piaseczno/';
const title = 'Strony internetowe Piaseczno – tworzenie stron od 3000 zł | top.strony';
const description = 'Tworzenie stron internetowych w Piasecznie. Biuro przy ul. Strusiej 3C, spotkanie na miejscu, strona od 3 000 zł netto, SEO lokalne i Mapy Google w cenie. Wycena w 24 h.';
const AUTHOR = { name: 'Kamil Piech', linkedin: 'https://www.linkedin.com/in/kamil-piech-674b7912a/' };

import home from '../../../data/pages/home.json';
const logos = (home.logosLoop as any[]).slice(0, 15);
const gallery = [
  { src: '/img/piaseczno/pz-kawiarnia-spotkanie.webp', alt: 'Spotkanie z klientem w kawiarni w Piasecznie: omawianie nowej strony internetowej na laptopie', cap: 'Pierwsza rozmowa przy kawie w Piasecznie. Pokazujemy przykłady i pytamy o Twoich klientów.', cls: 'g-a' },
  { src: '/img/piaseczno/pz-szkic-makiety.webp', alt: 'Szkic makiety strony internetowej na papierze obok laptopa i telefonu', cap: 'Makieta powstaje na papierze, zanim ktokolwiek otworzy program graficzny.', cls: 'g-b' },
  { src: '/img/piaseczno/pz-biuro-projekt.webp', alt: 'Projektowanie strony internetowej w biurze top.strony w Piasecznie', cap: 'Projekt i kodowanie w biurze przy ul. Strusiej 3C.', cls: 'g-c' },
  { src: '/img/piaseczno/pz-klientka-kwiaciarnia.webp', alt: 'Właścicielka kwiaciarni pokazuje na telefonie swoją nową stronę internetową', cap: 'Efekt: strona, którą klient z okolicy znajdzie w telefonie i od razu zadzwoni.', cls: 'g-d' },
];
const why = [
  ['Spotkanie na miejscu', 'Przy kawie w biurze na Strusiej albo u Ciebie w firmie w Piasecznie, Józefosławiu czy Konstancinie. Zdalnie też się da.', 'M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5'],
  ['Znamy lokalne wyniki Google', 'Wiemy, kto wyświetla się na „Piaseczno” w Twojej branży i czego szukają klienci. Strukturę strony układamy pod te frazy.', 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-5-5'],
  ['Strona razem z Mapami', 'Łączymy stronę z Profilem Firmy w Google, żeby firma pokazywała się w Mapach na „w pobliżu”.', 'M3 3v18h18M7 14l4-4 3 3 6-6'],
  ['Jeden opiekun', 'Od wyceny po opiekę po starcie rozmawiasz z tą samą osobą. Telefon odbieramy od 9 do 20.', 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z'],
];

const offers = [
  { badge: '2–3 tygodnie', h: 'Strona wizytówka', p: 'Jedna strona z ofertą, cennikiem, opiniami i kontaktem. Dla gabinetu, salonu, warsztatu albo firmy usługowej, która chce telefonów od klientów z okolicy.', li: ['do 5 sekcji, wersja na telefon', 'formularz i pomiar w GA4', 'SEO lokalne na start'], price: 'od 3 000 zł netto', hot: false },
  { badge: 'Najczęściej wybierana · 1–2 tygodnie', h: 'Serwis firmowy', p: 'Osobna podstrona dla każdej usługi i miejscowości, blog i panel do edycji. Dla firm, które chcą być wysoko na kilka fraz naraz.', li: ['podstrony usług i miejscowości', 'blog i baza wiedzy', 'Astro albo WordPress'], price: 'wycena w 24 h', hot: true },
  { badge: '3–6 tygodni', h: 'Nowa strona w miejsce starej', p: 'Przebudowa strony, która jest wolna albo przestała przynosić zapytania. Przenosimy treści i ustawiamy przekierowania, żeby nie stracić pozycji.', li: ['audyt starej strony', 'mapa przekierowań 301', 'migracja treści i zdjęć'], price: 'wycena w 24 h', hot: false },
];

const steps = [
  ['Rozmowa w Piasecznie lub przez telefon', 'Pytamy o klientów, konkurencję i to, skąd dziś przychodzą zapytania.'],
  ['Wycena w 24 godziny', 'Zakres, termin i cena na piśmie. Bez ukrytych dopłat po starcie.'],
  ['Makieta i projekt graficzny', 'Najpierw układ treści, potem wygląd w Figmie. Akceptujesz każdy etap.'],
  ['Kodowanie', 'Astro dla szybkości albo WordPress dla częstej edycji. Wersja testowa jest ukryta przed Google.'],
  ['SEO lokalne', 'Frazy z „Piaseczno”, dane strukturalne firmy lokalnej, Profil Firmy w Google i mapa strony.'],
  ['Start, szkolenie i opieka', 'Uruchamiamy stronę na Twojej domenie, pokazujemy panel i zostajemy pod telefonem.'],
];

const seo = [
  'Nagłówki i podstrony pod frazy typu „strony internetowe Piaseczno” i „usługa + Piaseczno”',
  'Ten sam adres i telefon na stronie, w Profilu Firmy w Google i w katalogach',
  'Dane strukturalne LocalBusiness z adresem, godzinami i obszarem działania',
  'Szybkie ładowanie na telefonie, bo większość lokalnych wyszukiwań jest z komórki',
  'Sekcja pytań i odpowiedzi, którą łatwo zacytować asystentom AI',
];

const areas = ['Piaseczno', 'Józefosław', 'Julianów', 'Zalesie Dolne', 'Zalesie Górne', 'Chylice', 'Gołków', 'Złotokłos', 'Stara i Nowa Iwiczna', 'Lesznowola', 'Konstancin-Jeziorna', 'Góra Kalwaria', 'Prażmów', 'Tarczyn', 'Warszawa Ursynów', 'Warszawa Wilanów'];

const cases = [
  { slug: 'eurodomy', img: '/img/realizacja-eurodomy-pl.webp', place: 'Złotokłos, gmina Piaseczno', h: 'Eurodomy.pl', p: 'Generalny wykonawca domów. Strona z ofertą, realizacjami i kampanią Google Ads.' },
  { slug: 'pure-rehab', img: '/img/realizacja-pure-rehab.webp', place: 'Nowa Iwiczna, gmina Lesznowola', h: 'Pure Rehab', p: 'Klinika fizjoterapii. Strona, SEO lokalne i social media.' },
  { slug: 'psotel-gracja', img: '/img/realizacja-psotel-gracja.webp', place: 'Okolice Piaseczna', h: 'Psotel Gracja', p: 'Hotel dla psów. Strona z rezerwacjami i kampanią Google Ads.' },
];

const reviews = [
  ['Adrian Wojnarowski', 'Zrobili mi porządną stronę internetową, która bez znacznego marketingu generuje zapytania klientów. Polecam z nimi działać.'],
  ['Michał Szymański', 'Świetna realizacja projektu strony dla naszej firmy. Plusy za terminowość oraz świetny kontakt na każdym etapie projektu. Polecam.'],
  ['Damian Konieczny', 'Współpraca z tą firmą to czysta przyjemność. Doskonałe doradztwo, a strona jest elegancka i łatwa w nawigacji.'],
];

const faqs = [
  { q: 'Ile kosztuje strona internetowa w Piasecznie?', a: 'Strona internetowa kosztuje u nas od 3 000 zł netto. Cena zależy od liczby podstron, technologii i tego, czy piszemy treści. Dokładną wycenę z zakresem i terminem wysyłamy w 24 godziny.' },
  { q: 'Ile trwa zrobienie strony internetowej?', a: 'Wizytówka powstaje w 2–3 tygodnie, serwis firmowy z podstronami w 1–2 tygodnie. Najwięcej zależy od tego, jak szybko dostaniemy treści, zdjęcia i akceptacje.' },
  { q: 'Czy mogę spotkać się z Wami w Piasecznie?', a: 'Tak. Biuro jest przy ul. Strusiej 3C lok. 31 w Piasecznie, pracujemy od poniedziałku do piątku w godzinach 9–20. Możemy też przyjechać do Twojej firmy albo porozmawiać zdalnie.' },
  { q: 'Czy strona będzie widoczna w Google na frazy z Piasecznem?', a: 'Każdą stronę oddajemy z SEO lokalnym: nagłówkami i podstronami pod frazy z nazwą miasta, danymi strukturalnymi firmy lokalnej i połączeniem z Profilem Firmy w Google. Wysokie pozycje na konkurencyjne frazy wymagają potem stałego pozycjonowania, co też robimy.' },
  { q: 'WordPress czy strona pisana kodem?', a: 'Strona w Astro ładuje się szybciej i jest bezpieczniejsza, a WordPress daje wygodny panel do częstych zmian. Technologię dobieramy po rozmowie o tym, jak często będziesz zmieniać treści.' },
  { q: 'Czy zajmujecie się też wizytówką Google?', a: 'Tak. Zakładamy albo porządkujemy Profil Firmy w Google, dodajemy zdjęcia, godziny i usługi oraz łączymy go ze stroną, żeby firma pokazywała się w Mapach.' },
  { q: 'Mam już stronę. Czy zmiana nie zepsuje pozycji?', a: 'Przed przeniesieniem robimy audyt starej strony i mapę przekierowań 301 ze starych adresów na nowe. Dzięki temu Google i klienci trafiają na właściwe podstrony.' },
  { q: 'Czy obsługujecie firmy spoza Piaseczna?', a: 'Tak. Najczęściej pracujemy z firmami z Józefosławia, Konstancina-Jeziorny, Lesznowoli, Góry Kalwarii i Ursynowa, ale projekty prowadzimy też zdalnie w całej Polsce.' },
  { q: 'Czy strona i domena będą moje?', a: 'Tak. Domena, hosting, pliki strony i konta analityczne należą do Ciebie. Po starcie przekazujemy wszystkie dostępy.' },
];

const ld = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Strony internetowe Piaseczno', serviceType: 'Tworzenie stron internetowych', description, url: SITE + path,
    provider: { '@id': SITE + '/#business' },
    areaServed: areas.map((a) => ({ '@type': 'Place', name: a })),
    offers: { '@type': 'Offer', priceCurrency: 'PLN', price: '3000', priceSpecification: { '@type': 'UnitPriceSpecification', price: '3000', priceCurrency: 'PLN', valueAddedTaxIncluded: false }, description: 'Strona internetowa od 3 000 zł netto' } },
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: SITE + path, inLanguage: 'pl-PL', dateModified: '2026-11-24',
    author: { '@type': 'Person', name: AUTHOR.name, url: SITE + '/o-nas/', sameAs: [AUTHOR.linkedin] }, primaryImageOfPage: SITE + '/img/piaseczno/rynek-piaseczno-og.jpg', image: gallery.map((g) => SITE + g.src),
    about: { '@type': 'Place', name: 'Piaseczno', address: { '@type': 'PostalAddress', addressLocality: 'Piaseczno', postalCode: '05-500', addressCountry: 'PL' } } },
  faqLd(faqs),
  crumbs([['Strona główna', '/'], ['Usługi', '/uslugi/'], ['Strony internetowe', '/uslugi/strony-internetowe/'], ['Strony internetowe Piaseczno', path]]),
];
---
<Base v={v} page="local-piaseczno" path={path} jsonLd={ld} title={title} description={description} image="/img/piaseczno/rynek-piaseczno-og.jpg">
  <main id="main" class="pz">
  <section class="pz-hero" aria-labelledby="pz-h1">
    <img class="pz-hero-bg" src="/img/piaseczno/rynek-piaseczno.webp" alt="Rynek w Piasecznie z ratuszem i fontanną na placu Piłsudskiego" width="2000" height="1333" fetchpriority="high" decoding="async">
    <div class="pz-hero-ov" aria-hidden="true"></div>
    <div class="wrap pz-hero-in">
      <nav class="pz-crumbs" aria-label="Okruszki"><ol><li><a href="/">Strona główna</a></li><li><a href="/uslugi/">Usługi</a></li><li><a href="/uslugi/strony-internetowe/">Strony internetowe</a></li><li aria-current="page">Strony internetowe Piaseczno</li></ol></nav>
      <p class="pz-pin"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8FD35A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>Biuro w Piasecznie · ul. Strusia 3C</p>
      <h1 id="pz-h1" class="pz-h1" data-gs="hero">Strony internetowe Piaseczno</h1>
      <p class="pz-sub" data-gs="hero">Tworzenie stron internetowych w Piasecznie, od projektu do telefonów od klientów</p>
      <p class="pz-lead" data-gs="hero">Projektujemy i kodujemy szybkie strony dla firm z Piaseczna i okolic. Spotkasz się z nami na miejscu, a strona od pierwszego dnia jest przygotowana pod frazy z nazwą miasta i pod Mapy Google.</p>
      <div class="pz-cta" data-gs="hero">
        <a data-magnetic href="/kontakt/" class="btn btn-g">Bezpłatna wycena w 24 h <span aria-hidden="true">→</span></a>
        <a href="tel:+48501784882" class="pz-ghost">Zadzwoń: 501 784 882</a>
      </div>
      <ul class="pz-stats" data-gs="hero">
        <li><b>5,0 ★</b><span>średnia z 20 opinii w Google</span></li>
        <li><b>35</b><span>stron i sklepów w portfolio</span></li>
        <li><b>od 3 000 zł</b><span>netto za stronę internetową</span></li>
        <li><b>1–3 tyg.</b><span>od rozmowy do startu strony</span></li>
      </ul>
    </div>
  </section>

  <section class="sec pz-short" aria-labelledby="pz-skrot">
    <div class="wrap">
      <div class="pz-answer rv">
        <div>
          <p id="pz-skrot" class="pz-k">W skrócie</p>
          <p><strong>top.strony to agencja z Piaseczna (ul. Strusia 3C), która projektuje i koduje strony internetowe dla lokalnych firm.</strong> Strona internetowa kosztuje od 3 000 zł netto. Wizytówkę robimy w 2–3 tygodnie, serwis firmowy w 1–2 tygodnie. Każda strona ma w cenie SEO lokalne pod frazy z „Piaseczno”, połączenie z Profilem Firmy w Google i pomiar telefonów w GA4. Wycenę wysyłamy w 24 godziny.</p>
        </div>
        <dl class="pz-nap">
          <div><dt>Adres</dt><dd>ul. Strusia 3C lok. 31, 05-500 Piaseczno</dd></div>
          <div><dt>Godziny</dt><dd>pon.–pt. 9:00–20:00</dd></div>
          <div><dt>Cena</dt><dd>od 3 000 zł netto</dd></div>
          <div><dt>Telefon</dt><dd><a href="tel:+48501784882">501 784 882</a></dd></div>
        </dl>
      </div>
    </div>
  </section>


  <section class="pz-logos" aria-labelledby="pz-logos-h">
    <div class="wrap">
      <p id="pz-logos-h" class="pz-logos-h">Zaufali nam przedsiębiorcy z Piaseczna, Warszawy i całej Polski</p>
    </div>
    <div class="pz-mq">
      <div class="marquee">
        {[...logos, ...logos].map((l: any) => (<span class="mlogo" role="img" aria-label={l.name} style={l.mask}></span>))}
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="pz-why">
    <div class="wrap">
      <p class="eyebrow scr">Agencja z Piaseczna</p>
      <h2 id="pz-why" class="h h2 split">Dlaczego firmy z Piaseczna robią stronę u nas</h2>
      <p class="lead pz-narrow">Nie musisz jechać do Warszawy ani rozmawiać z handlowcem, który przekaże projekt dalej. Projekt prowadzi jedna osoba, a spotkać się możesz przy ul. Strusiej, kilka minut od rynku.</p>
      <div class="pz-grid4">
        {why.map((w, i) => (
          <article class="pz-card rv" style={`transition-delay:${i * 0.06}s`}>
            <span class="pz-ic" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={w[2]}></path></svg></span>
            <h3 class="h">{w[0]}</h3>
            <p>{w[1]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>


  <section class="sec pz-gal-sec" aria-labelledby="pz-gal">
    <div class="wrap">
      <p class="eyebrow scr">Jak wygląda współpraca</p>
      <h2 id="pz-gal" class="h h2 split">Od kawy w Piasecznie do strony, która przynosi klientów</h2>
      <p class="lead pz-narrow">Większość projektów zaczynamy od spotkania na miejscu: w biurze, u klienta albo w kawiarni w centrum Piaseczna. Tak wygląda droga od pomysłu do gotowej strony.</p>
      <div class="pz-gal">
        {gallery.map((g) => (
          <figure class={`pz-gfig ${g.cls}`} data-gs="reveal">
            <div class="pz-gimg"><img src={g.src} alt={g.alt} width="1344" height="752" loading="lazy" decoding="async"></div>
            <figcaption>{g.cap}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="oferta" class="sec alt" aria-labelledby="pz-off">
    <div class="wrap">
      <p class="eyebrow scr">Co robimy</p>
      <h2 id="pz-off" class="h h2 split">Tworzenie stron internetowych w Piasecznie: co robimy</h2>
      <div class="pz-grid3">
        {offers.map((o, i) => (
          <article class={`pz-offer rv ${o.hot ? 'is-hot' : ''}`} style={`transition-delay:${i * 0.06}s`}>
            <span class="pz-badge">{o.badge}</span>
            <h3 class="h">{o.h}</h3>
            <p>{o.p}</p>
            <ul>{o.li.map((x) => <li>{x}</li>)}</ul>
            <p class="pz-price">{o.price}</p>
          </article>
        ))}
      </div>
      <p class="pz-note rv">Sprzedajesz online? Zobacz <a href="/uslugi/sklepy-internetowe/">sklepy internetowe</a>. Strona już jest, ale nikt jej nie znajduje? Zobacz <a href="/uslugi/pozycjonowanie-seo/">pozycjonowanie SEO</a>. Pełny zakres usługi opisujemy na stronie <a href="/uslugi/strony-internetowe/">tworzenie stron internetowych</a>, a firmy ze stolicy zapraszamy na stronę <a href="/uslugi/strony-internetowe/warszawa/">strony internetowe Warszawa</a>.</p>
    </div>
  </section>

  <section class="sec" aria-labelledby="pz-proc">
    <div class="wrap">
      <p class="eyebrow scr">Jak pracujemy</p>
      <h2 id="pz-proc" class="h h2 split">Od rozmowy do strony w 6 krokach</h2>
      <ol class="pz-flow" data-gs="steps">
        {steps.map((s, i) => (
          <li class={`pz-st ${i % 2 ? 'is-r' : 'is-l'}`} style={`--i:${i}`}>
            <span class="pz-bignum" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="pz-node" aria-hidden="true">{i + 1}</span>
            <div class="pz-stc"><small>Krok {i + 1} z {steps.length}</small><h3 class="h">{s[0]}</h3><p>{s[1]}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec alt" aria-labelledby="pz-seo">
    <div class="wrap pz-split">
      <div class="rv">
        <p class="eyebrow scr">SEO lokalne w cenie</p>
        <h2 id="pz-seo" class="h h2 split">Strona, którą klienci z Piaseczna znajdą w Google i w Mapach</h2>
        <p class="lead">Ładna strona bez widoczności nie przynosi telefonów. Dlatego każdą stronę oddajemy z podstawami SEO lokalnego, a nie dopiero po dopłacie.</p>
        <ul class="pz-checks">
          {seo.map((x) => (<li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>{x}</li>))}
        </ul>
      </div>
      <div class="pz-area rv d1">
        <h3 class="h">Gdzie pracujemy</h3>
        <p>Piaseczno i cały powiat piaseczyński, a także południe Warszawy.</p>
        <ul data-gs="chips">{areas.map((a, i) => <li class={i === 0 ? 'is-main' : ''}>{a}</li>)}</ul>
      </div>
    </div>
  </section>

  <section id="realizacje" class="sec" aria-labelledby="pz-real">
    <div class="wrap">
      <p class="eyebrow scr">Realizacje</p>
      <h2 id="pz-real" class="h h2 split">Strony, które zrobiliśmy w okolicy Piaseczna</h2>
      <div class="pz-grid3">
        {cases.map((c, i) => (
          <a href={`/realizacje/${c.slug}/`} class="pz-case rv" style={`transition-delay:${i * 0.06}s`}>
            <img src={c.img} alt={`Strona ${c.h}`} width="1200" height="750" loading="lazy" decoding="async">
            <span class="pz-case-b"><small>{c.place}</small><b>{c.h}</b><span>{c.p}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="opinie" class="sec alt deco-wave deco-alt2" aria-labelledby="opinie-h">
    <div class="wrap">
      <div class="head rv">
        <div>
          <p class="eyebrow scr">Opinie z Google</p>
          <h2 id="opinie-h" class="h h2 split"><span class="wm"><span class="wi">Klienci</span></span> <span class="wm"><span class="wi">wystawiają</span></span> <span class="wm"><span class="wi">nam</span></span> <span class="wm"><span class="wi">5,0.</span></span> <span class="wm"><span class="wi">Każdy</span></span> <span class="wm"><span class="wi">z</span></span> <span class="wm"><span class="wi">nich.</span></span></h2>
        </div>
