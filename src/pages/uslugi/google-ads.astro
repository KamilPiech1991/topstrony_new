<script>
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement | null;
  const B = $('gcB'), C = $('gcC'), R = $('gcR');
  const nf = new Intl.NumberFormat('pl-PL', { maximumFractionDigits: 0 });
  const nf2 = new Intl.NumberFormat('pl-PL', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const set = (id: string, t: string) => { const e = document.getElementById(id); if (e) e.textContent = t; };
  function calc() {
    if (!B || !C || !R) return;
    const b = +B.value, c = +C.value, r = +R.value / 100;
    const k = Math.round(b / c), l = Math.round(k * r);
    set('gcBo', nf.format(b) + ' zł'); set('gcCo', nf2.format(c) + ' zł'); set('gcRo', String(R.value).replace('.', ',') + '%');
    set('gcK', nf.format(k)); set('gcL', nf.format(l)); set('gcCpl', l ? nf.format(b / l) + ' zł' : '–');
    const b1 = document.getElementById('gcBar1'), b2 = document.getElementById('gcBar2');
    if (b1) b1.style.width = Math.min(100, k / 60) + '%';
    if (b2) b2.style.width = Math.min(100, l / 6) + '%';
  }
  [B, C, R].forEach((e) => e?.addEventListener('input', calc));
  calc();
</script>
