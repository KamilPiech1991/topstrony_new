---
import Base from '../../layouts/Base.astro';
import v from '../../data/pages/srv-ads.json';
import { crumbs, faqLd, SITE } from '../../data/site';
import '../../styles/gads.css';

const path = '/uslugi/google-ads/';
const title = 'Kampanie Google Ads dla firm: prowadzenie i optymalizacja | top.strony';
const description = 'Prowadzimy kampanie Google Ads: Search, Performance Max, Zakupy, YouTube i remarketing. Pomiar każdego zapytania w GA4, bezpłatny audyt konta, raport co miesiąc.';
const AUTHOR = { name: 'Kamil Piech', linkedin: 'https://www.linkedin.com/in/kamil-piech-674b7912a/' };

const types = [
  { k: 'search', t: 'Kampania w sieci wyszukiwania (Search)', stage: 'Decyzja', d: 'Reklama tekstowa nad wynikami Google, gdy ktoś wpisuje frazę typu „hydraulik Piaseczno”. Trafiasz do osób, które już szukają usługi.', who: 'Usługi lokalne, B2B, sklepy, kancelarie, gabinety', icon: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-5-5' },
  { k: 'pmax', t: 'Performance Max', stage: 'Cały lejek', d: 'Jedna kampania wyświetla się w wyszukiwarce, na YouTube, w Gmailu, Discover, Mapach i sieci reklamowej. Algorytm sam rozdziela budżet tam, gdzie widzi konwersje.', who: 'Sklepy z Merchant Center, usługi z dobrym pomiarem', icon: 'M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z' },
  { k: 'shop', t: 'Kampania produktowa (Zakupy Google)', stage: 'Decyzja', d: 'Zdjęcie produktu, cena i nazwa sklepu jeszcze przed kliknięciem. Dane pochodzą z pliku produktowego w Google Merchant Center.', who: 'Sklepy internetowe z fizycznymi produktami', icon: 'M6 6h15l-1.5 9h-12zM6 6L5 3H2M9 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2zM18 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2' },
  { k: 'local', t: 'Reklama w Mapach Google', stage: 'Decyzja', d: 'Wyróżnienie firmy w Mapach i wynikach lokalnych, z adresem, telefonem i przyciskiem trasy. Od 2022 roku dawne kampanie lokalne działają w ramach Performance Max z celem wizyt w lokalu.', who: 'Salony, warsztaty, restauracje, kliniki', icon: 'M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5' },
  { k: 'remk', t: 'Remarketing', stage: 'Powrót', d: 'Reklamy dla osób, które były na Twojej stronie, ale nie zadzwoniły i nie kupiły. Działa w sieci reklamowej, na YouTube i w wyszukiwarce.', who: 'Sklepy (porzucone koszyki), usługi z dłuższą decyzją, B2B', icon: 'M3 12a9 9 0 1 0 3-6.7M3 4v5h5' },
  { k: 'display', t: 'Sieć reklamowa (Display)', stage: 'Zainteresowanie', d: 'Banery i animacje na milionach stron i aplikacji partnerów Google. Dobre do zasięgu i przypominania się po wizycie na stronie.', who: 'Marki budujące rozpoznawalność, remarketing', icon: 'M3 4h18v12H3zM8 20h8M12 16v4' },
  { k: 'video', t: 'Kampania wideo (YouTube)', stage: 'Świadomość', d: 'Reklamy przed filmem, w trakcie i w rekomendacjach YouTube, także w Shorts. Pokazujesz produkt albo zespół, zanim klient zacznie porównywać oferty.', who: 'Firmy z produktem, który dobrze wygląda na wideo', icon: 'M22 8s-.2-1.6-.8-2.3c-.8-.8-1.7-.8-2.1-.9C16 4.6 12 4.6 12 4.6s-4 0-7.1.2c-.4.1-1.3.1-2.1.9C2.2 6.4 2 8 2 8v3c0 1.6.2 3.2.2 3.2s.2 1.6.8 2.3c.8.8 1.9.8 2.4.9 1.7.2 6.6.2 6.6.2s4 0 7.1-.2c.4-.1 1.3-.1 2.1-.9.6-.7.8-2.3.8-2.3s.2-1.6.2-3.2zM10 15V8l6 3.5z' },
  { k: 'dg', t: 'Demand Gen (generowanie popytu)', stage: 'Świadomość', d: 'Następca kampanii Discovery. Wizualne reklamy w YouTube, Shorts, Gmailu i Discover, kierowane do osób podobnych do Twoich klientów.', who: 'Nowe produkty, sklepy szukające nowych klientów', icon: 'M13 2L3 14h9l-1 8 10-12h-9z' },
];

const fit = [
  ['Usługi lokalne (hydraulik, gabinet, warsztat)', 'Search na frazy z miastem', 'Mapy (PMax z celem wizyt), remarketing'],
  ['Sklep internetowy', 'Zakupy Google i Performance Max', 'Search na marki i kategorie, remarketing dynamiczny'],
  ['Firma B2B z formularzem', 'Search na frazy problemowe', 'Remarketing, YouTube dla decydentów'],
  ['Nowy produkt lub nowa marka', 'Demand Gen i YouTube', 'Search na nazwę marki, gdy rośnie popyt'],
];

const scope = [
  ['Bezpłatny audyt konta', 'Sprawdzamy strukturę kampanii, frazy, wykluczenia, budżety i to, czy konwersje w ogóle są mierzone.'],
  ['Pomiar konwersji', 'GA4, Google Tag Manager, konwersje z telefonów, formularzy i zakupów oraz Consent Mode v2.'],
  ['Badanie słów kluczowych', 'Frazy z intencją zakupu, szacunek kosztu kliknięcia i lista wykluczeń przed startem.'],
  ['Teksty i zasoby reklam', 'Nagłówki, opisy, rozszerzenia z telefonem, adresem i linkami, grafiki do PMax i Demand Gen.'],
  ['Merchant Center', 'Konfiguracja i pilnowanie pliku produktowego, żeby żaden produkt nie wypadł z Zakupów.'],
  ['Strona docelowa', 'Uwagi do landing page albo nowa strona, bo od niej zależy Wynik Jakości i koszt kliknięcia.'],
  ['Optymalizacja co tydzień', 'Stawki, wyszukiwane hasła, wykluczenia, testy reklam i przesuwanie budżetu.'],
  ['Raport co miesiąc', 'Ile wydaliśmy, ile było telefonów i formularzy, ile kosztował jeden klient i co robimy dalej.'],
];

const steps = [
  ['Dzień 1–3', 'Audyt albo analiza rynku', 'Przegląd konta lub, przy starcie od zera, analiza konkurencji i popytu na frazy.'],
  ['Tydzień 1', 'Pomiar', 'GA4, Tag Manager i konwersje Google Ads. Bez tego nie da się optymalizować.'],
  ['Tydzień 1–2', 'Budowa kampanii', 'Struktura konta, grupy reklam, teksty, rozszerzenia, wykluczenia i harmonogram.'],
  ['Tydzień 2–6', 'Faza nauki', 'Algorytm zbiera dane. Co tydzień czyścimy wyszukiwane hasła i poprawiamy reklamy.'],
  ['Od 2. miesiąca', 'Skalowanie', 'Zwiększamy budżet tam, gdzie koszt zapytania jest najniższy, i wyłączamy resztę.'],
];

const cmp = [
  ['Kiedy pierwsze efekty', 'zwykle w kilka dni od startu', 'zwykle po 3–6 miesiącach'],
  ['Koszt', 'płacisz za każde kliknięcie', 'płacisz za pracę, kliknięcia są bezpłatne'],
  ['Po wyłączeniu', 'ruch z reklam znika od razu', 'pozycje utrzymują się dłużej'],
  ['Kontrola', 'wybierasz frazy, region, godziny i budżet', 'Google decyduje o pozycji'],
  ['Najlepsze do', 'szybkich zapytań, sezonu, promocji', 'stałego ruchu i niższego kosztu klienta'],
];

const faqs = [
  { q: 'Ile kosztuje kampania Google Ads?', a: 'Na koszt składają się dwie rzeczy: budżet reklamowy, który płacisz bezpośrednio Google za kliknięcia, oraz nasza opłata za prowadzenie kampanii. Budżet zależy od kosztu kliknięcia w Twojej branży i regionie. Po bezpłatnym audycie podajemy rekomendowany budżet dzienny i szacunek liczby zapytań, a wycenę obsługi wysyłamy w 24 godziny.' },
  { q: 'Jaki budżet na Google Ads wystarczy na start?', a: 'Taki, który pozwoli zebrać kilkadziesiąt kliknięć dziennie na najważniejsze frazy. Przy usługach lokalnych to często kilkadziesiąt złotych dziennie, w konkurencyjnych branżach więcej. Lepiej zacząć od mniejszego budżetu na dobrze dobranych frazach i zwiększać go, gdy widać koszt zapytania, niż od razu wydać dużo na szeroki ruch.' },
  { q: 'Po jakim czasie widać efekty Google Ads?', a: 'Pierwsze kliknięcia i telefony pojawiają się zwykle w ciągu kilku dni od uruchomienia. Kampanie z automatycznym ustalaniem stawek potrzebują jednak 2–6 tygodni na zebranie danych o konwersjach. Dopiero po tym czasie koszt zapytania się stabilizuje i można rozsądnie zwiększać budżet.' },
  { q: 'Który rodzaj kampanii Google Ads wybrać?', a: 'Jeśli klienci wpisują Twoją usługę w Google, zacznij od kampanii w sieci wyszukiwania. Sklep internetowy najlepiej zaczyna od Zakupów Google i Performance Max. Nowy produkt, o którym jeszcze nikt nie wie, potrzebuje YouTube albo Demand Gen. Remarketing dokładamy prawie zawsze, gdy strona ma już ruch.' },
  { q: 'Czym jest Wynik Jakości i dlaczego obniża koszt kliknięcia?', a: 'Wynik Jakości to ocena od 1 do 10, którą Google przyznaje słowom kluczowym. Składają się na nią przewidywany CTR, trafność reklamy i jakość strony docelowej. Reklama z wyższą jakością może zająć lepszą pozycję przy niższej stawce, dlatego pracujemy też nad tekstami reklam i stroną, a nie tylko nad stawkami.' },
  { q: 'Czy konto Google Ads będzie moje?', a: 'Tak. Konto reklamowe, GA4 i Merchant Center zakładamy na Twoją firmę albo pracujemy na Twoich kontach. Masz pełny dostęp przez cały czas, a po zakończeniu współpracy wszystko zostaje u Ciebie razem z historią kampanii.' },
  { q: 'Skąd będę wiedzieć, że reklama działa?', a: 'Mierzymy telefony, formularze i zakupy w GA4 i w Google Ads. Co miesiąc dostajesz raport z wydatkami, liczbą zapytań i kosztem pozyskania jednego klienta. Konto możesz też sprawdzić sam w dowolnym momencie.' },
  { q: 'Czy Google Ads ma sens dla małej firmy lokalnej?', a: 'Tak, często największy. Kampania może być ograniczona do Piaseczna, Warszawy albo promienia kilkunastu kilometrów i do godzin, w których odbierasz telefon. Płacisz tylko za kliknięcia osób z tego obszaru, które szukają Twojej usługi.' },
  { q: 'Google Ads czy pozycjonowanie SEO?', a: 'Google Ads daje zapytania od razu, ale tylko dopóki płacisz za kliknięcia. SEO buduje ruch, który zostaje, ale na efekty czeka się miesiącami. Najlepiej działa połączenie: reklamy przynoszą klientów od pierwszego tygodnia, a SEO z czasem obniża średni koszt pozyskania klienta.' },
  { q: 'Czy zrobicie audyt mojej obecnej kampanii?', a: 'Tak, audyt konta na start jest bezpłatny. Dostajesz listę błędów i rekomendacji, na przykład frazy, które zjadają budżet bez efektu, albo brakujący pomiar konwersji. Możesz z nich skorzystać nawet bez dalszej współpracy z nami.' },
];

const ld = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Kampanie Google Ads', serviceType: 'Prowadzenie kampanii Google Ads', description,
    url: SITE + path, provider: { '@id': SITE + '/#business' }, areaServed: [{ '@type': 'City', name: 'Piaseczno' }, { '@type': 'City', name: 'Warszawa' }, { '@type': 'Country', name: 'Polska' }],
    hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Rodzaje kampanii Google Ads', itemListElement: types.map((t) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: t.t, description: t.d } })) } },
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: SITE + path, inLanguage: 'pl-PL', dateModified: '2026-11-23',
    author: { '@type': 'Person', name: AUTHOR.name, url: SITE + '/o-nas/', sameAs: [AUTHOR.linkedin] }, primaryImageOfPage: SITE + '/img/gads/gads-specjalistka.webp' },
  faqLd(faqs),
  crumbs([['Strona główna', '/'], ['Usługi', '/uslugi/'], ['Kampanie Google Ads', path]]),
];
---
<Base v={v} page="srv-google-ads" path={path} jsonLd={ld} title={title} description={description} image="/img/gads/gads-specjalistka.webp">
  <main id="main">
  <section class="sv-hero2 ga-hero" aria-labelledby="sv-h1">
    <span class="sv-orb o1" aria-hidden="true"></span><span class="sv-orb o2" aria-hidden="true"></span><span class="sv-orb o3" aria-hidden="true"></span>
    <div class="wrap">
      <nav class="sv-crumbs h-in" aria-label="Okruszki">
        <ol>
          <li><a href="/">Strona główna</a></li>
          <li><a href="/uslugi/">Usługi</a></li>
          <li><a href="/uslugi/kampanie-google-meta-ads/">Google i Meta Ads</a></li>
          <li aria-current="page">Google Ads</li>
        </ol>
      </nav>
      <h1 id="sv-h1" class="sv-disp">
        <span class="sv-l l1"><span class="sv-lt">Kampanie Google Ads,</span></span>
        <span class="sv-l l2"><span class="sv-lt">które dzwonią</span></span>
        <span class="sv-l l3"><span class="sv-lt">do Twojej firmy</span><i class="sv-ic c3" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg></i></span>
      </h1>
      <div class="sv-hero2-foot">
        <div class="sv-hero2-tx">
          <p class="sv-kicker">Google Ads · top.strony · Piaseczno i cała Polska</p>
          <p class="sv-hero2-lead">Prowadzimy kampanie w wyszukiwarce, Zakupach Google, Mapach, Performance Max i na YouTube. Rozliczamy je z telefonów, formularzy i sprzedaży, a nie z liczby kliknięć.</p>
        </div>
        <div class="sv-hero2-cta">
          <a data-magnetic href="/kontakt/" class="btn sv-btn-dark">Bezpłatny audyt konta <span aria-hidden="true">→</span></a>
          <a href="tel:+48501784882" class="sv-hero2-tel">albo zadzwoń: 501 784 882</a>
        </div>
      </div>
      <nav class="sv-toc" aria-label="Na tej stronie">
        <span>Na tej stronie:</span>
        <a href="#czym-jest">Czym jest</a><a href="#rodzaje">Rodzaje kampanii</a><a href="#lejek">Lejek</a><a href="#aukcja">Aukcja</a><a href="#kalkulator">Kalkulator</a><a href="#zakres">Zakres</a><a href="#proces">Proces</a><a href="#faq">FAQ</a>
      </nav>
    </div>
  </section>

  <section id="czym-jest" class="sec alt deco-bars deco-l" aria-labelledby="ga-def-h">
    <div class="wrap">
      <div class="ga-answer rv">
        <p class="ga-answer-k">W skrócie</p>
        <p><strong>Google Ads to system reklam Google, w którym płacisz za kliknięcie w reklamę</strong> wyświetlaną w wyszukiwarce, Mapach, YouTube, Gmailu i na stronach partnerów. W top.strony zaczynamy od bezpłatnego audytu i pomiaru konwersji w GA4, potem budujemy kampanie dopasowane do celu (telefony, formularze albo sprzedaż), optymalizujemy je co tydzień i co miesiąc raportujemy koszt pozyskania klienta. Budżet reklamowy płacisz bezpośrednio Google.</p>
        <ul class="ga-facts">
          <li><b>0 zł</b><span>audyt konta na start</span></li>
          <li><b>8</b><span>typów kampanii w jednym koncie</span></li>
          <li><b>24 h</b><span>na wycenę obsługi</span></li>
          <li><b>100%</b><span>konto i dane należą do Ciebie</span></li>
        </ul>
      </div>
      <div class="sv-def ga-def">
        <div class="rv">
          <p class="eyebrow scr">Czym jest Google Ads</p>
          <h2 id="ga-def-h" class="h h2 split">Reklama, która pojawia się wtedy, gdy klient szuka</h2>
          <p class="lead">Ktoś wpisuje w Google „naprawa pieca Piaseczno” albo „ekspres kolbowy do kawiarni”. W ułamku sekundy Google przeprowadza aukcję i decyduje, czyje reklamy pokazać nad wynikami. Ty płacisz dopiero wtedy, gdy ta osoba kliknie, zadzwoni z reklamy albo przejdzie do sklepu.</p>
          <p class="lead">Najczęstszy problem, który widzimy w audytach, nie dotyczy stawek. Kampania wydaje pieniądze, ale nikt nie wie, ile przyniosła telefonów. Dlatego zawsze zaczynamy od pomiaru, a dopiero potem dokładamy budżet tam, gdzie widać wynik.</p>
        </div>
        <div class="card sv-for rv d2">
          <h3 class="h sv-h3">Dla kogo są kampanie Google Ads?</h3>
          <ul>
            {['Firmy usługowe, które potrzebują telefonów od zaraz', 'Sklepy internetowe: Zakupy Google, PMax i remarketing', 'Gabinety, kliniki, salony i warsztaty z lokalnymi klientami', 'Firmy B2B, które zbierają zapytania przez formularz', 'Firmy, które wydają budżet, ale nie wiedzą, co z niego mają'].map((w) => (
              <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>{w}</li>
            ))}
          </ul>
        </div>
      </div>
      <figure class="ga-fig rv">
        <img decoding="async" src="/img/gads/gads-specjalistka.webp" alt="Specjalistka top.strony analizuje wyniki kampanii Google Ads na laptopie" width="1344" height="752" loading="lazy">
        <figcaption>Wyniki kampanii sprawdzamy co tydzień: wyszukiwane hasła, koszt zapytania i reklamy, które warto wyłączyć.</figcaption>
      </figure>
    </div>
  </section>

  <section id="rodzaje" class="sec deco-rings" aria-labelledby="ga-types-h">
    <div class="wrap">
      <p class="eyebrow scr">Rodzaje kampanii</p>
      <h2 id="ga-types-h" class="h h2 split">8 rodzajów kampanii Google Ads i kiedy który wybrać</h2>
      <p class="lead ga-narrow">Każdy typ kampanii pracuje na innym etapie decyzji klienta. Nie uruchamiamy wszystkich naraz: wybieramy te, które pasują do Twojego celu i budżetu.</p>
      <div class="ga-types">
        {types.map((t, i) => (
          <article class={`ga-type rv ga-${t.k}`} style={`transition-delay:${(i % 4) * 0.06}s`}>
            <div class="ga-type-top">
              <span class="ga-type-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={t.icon}></path></svg></span>
              <span class="ga-stage">{t.stage}</span>
            </div>
            <h3 class="h">{t.t}</h3>
            <p>{t.d}</p>
            <p class="ga-who"><b>Dla kogo:</b> {t.who}</p>
          </article>
        ))}
      </div>
      <p class="ga-note rv">Wariant kampanii Search, który warto znać: <b>dynamiczne reklamy w wyszukiwarce (DSA)</b>. Google sam dopasowuje nagłówek do treści strony, co pomaga w dużych sklepach z setkami podstron.</p>
    </div>
  </section>

  <section id="lejek" class="sec alt deco-wave" aria-labelledby="ga-fun-h">
    <div class="wrap ga-split">
      <div class="rv">
        <p class="eyebrow scr">Diagram</p>
        <h2 id="ga-fun-h" class="h h2 split">Gdzie w lejku sprzedaży działa każda kampania</h2>
        <p class="lead">Klient najpierw dowiaduje się, że ma problem, potem porównuje oferty, a na końcu wybiera firmę. Kampanie na górze lejka są tańsze za kontakt, ale rzadziej kończą się telefonem. Te na dole kosztują więcej za kliknięcie, za to przynoszą zapytania.</p>
        <p class="lead">Mała firma zwykle zaczyna od dołu lejka, czyli od wyszukiwarki i Map. Wyżej idziemy dopiero wtedy, gdy dół działa i chcesz rosnąć szybciej.</p>
      </div>
      <figure class="ga-funnel rv d2" aria-labelledby="ga-fun-cap">
        <ol>
          <li style="--w:100%"><b>Świadomość</b><span>YouTube · Demand Gen</span></li>
          <li style="--w:86%"><b>Zainteresowanie</b><span>Sieć reklamowa · PMax</span></li>
          <li style="--w:72%"><b>Decyzja</b><span>Search · Zakupy · Mapy</span></li>
          <li style="--w:58%"><b>Powrót</b><span>Remarketing</span></li>
        </ol>
        <div class="ga-fun-axis" aria-hidden="true"><span>więcej osób, niższa intencja</span><span>mniej osób, gotowi kupić</span></div>
        <figcaption id="ga-fun-cap">Diagram: rodzaje kampanii Google Ads na etapach lejka sprzedaży.</figcaption>
      </figure>
    </div>
    <div class="wrap">
      <h3 class="h ga-h3 rv">Która kampania dla Twojej firmy?</h3>
      <div class="sv-cmp-wrap rv">
        <table class="sv-cmp ga-fit">
          <thead><tr><th scope="col">Rodzaj firmy</th><th scope="col" class="is-us">Od czego zacząć</th><th scope="col">Co dołożyć później</th></tr></thead>
