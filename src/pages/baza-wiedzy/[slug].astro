---
import Base from '../../layouts/Base.astro';
import home from '../../data/pages/home.json';
import { articles, kbUrl, fmtDate, isoDate } from '../../data/kb';
import { crumbs, SITE } from '../../data/site';
import '../../styles/kb.css';

const AUTHOR = { name: 'Kamil Piech', role: 'Założyciel top.strony · strony www, SEO i kampanie reklamowe', img: '/img/kamil-piech-k1cut.webp', linkedin: 'https://www.linkedin.com/in/kamil-piech-674b7912a/' };

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug }, props: { slug: a.slug } }));
}
const { slug } = Astro.props;
const art = articles.find((a) => a.slug === slug)!;
const { meta, Content } = art;
const toc = art.headings.filter((h) => h.depth === 2 || h.depth === 3);
const others = articles.filter((a) => a.slug !== slug).slice(0, 4);
const url = SITE + kbUrl(slug);

const ld = [
  crumbs([['Strona główna', '/'], ['Baza wiedzy', '/baza-wiedzy/'], [meta.title, kbUrl(slug)]]),
  { '@context': 'https://schema.org', '@type': 'Article', headline: meta.title, description: meta.description,
    image: SITE + meta.image, datePublished: isoDate(meta.date), dateModified: isoDate(meta.date),
    mainEntityOfPage: url, inLanguage: 'pl-PL',
    author: { '@type': 'Person', name: AUTHOR.name, url: SITE + '/o-nas/', jobTitle: 'Założyciel top.strony', sameAs: [AUTHOR.linkedin] },
    publisher: { '@type': 'Organization', name: 'top.strony', logo: { '@type': 'ImageObject', url: SITE + '/img/top-strony-logo-ink.webp' } } },
];
---
<Base v={home} page="baza" path={kbUrl(slug)} jsonLd={ld} image={meta.image}
  title={`${meta.title} | Baza wiedzy top.strony`} description={meta.description}>
  <main id="main">
    <header class="kb-art-hero">
      <div class="wrap">
        <ol class="kb-crumbs" aria-label="Ścieżka nawigacji">
          <li><a href="/">Strona główna</a></li>
          <li><a href="/baza-wiedzy/">Baza wiedzy</a></li>
          <li aria-current="page">{meta.title}</li>
        </ol>
        <h1 class="h h-in">{meta.title}</h1>
        <p class="kb-info">
          <span class="cat">{meta.category}</span>
          <time datetime={isoDate(meta.date)}>{fmtDate(meta.date)}</time>
          <span>{meta.readingTime} min czytania</span>
          <span>Autor: <a href={AUTHOR.linkedin} target="_blank" rel="noopener author" class="kb-auth-link">{AUTHOR.name}</a></span>
        </p>
      </div>
    </header>

    <div class="kb-body">
      <div class="wrap kb-layout">
        <aside class="kb-aside kb-aside-l" aria-label="Spis treści">
          <h2>Spis treści</h2>
          <ul class="kb-toc" data-toc>
            {toc.map((h) => (
              <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </aside>

        <article>
          <figure class="kb-fig"><img src={meta.image} alt={meta.imageAlt} width="1200" height="675" loading="eager" decoding="async" /></figure>
          <div class="kb-prose" data-prose><Content /></div>
          <div class="kb-author card">
            <img src={AUTHOR.img} alt={AUTHOR.name} width="96" height="96" loading="lazy" decoding="async" />
            <div>
              <small>Autor artykułu</small>
              <b>{AUTHOR.name}</b>
              <p>{AUTHOR.role}</p>
              <a href={AUTHOR.linkedin} target="_blank" rel="noopener author" class="kb-li">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
                Profil na LinkedIn
              </a>
            </div>
          </div>
        </article>

        <aside class="kb-aside kb-aside-r" aria-label="Inne artykuły">
          {others.length > 0 && (
            <>
              <h2>Inne artykuły</h2>
              <div class="kb-side-list kb-side-card card">
                {others.map((o) => (
                  <a href={kbUrl(o.slug)} class="kb-mini">
                    <img src={o.meta.image} alt="" width="84" height="64" loading="lazy" decoding="async" />
                    <span><b>{o.meta.title}</b><small>{o.meta.category} · {o.meta.readingTime} min</small></span>
                  </a>
                ))}
              </div>
            </>
          )}
          <div class="kb-cta-card">
            <b>Bezpłatna wycena w 24 h</b>
            <p>Opisz, czego potrzebujesz. Odpowiemy konkretnie i bez zobowiązań.</p>
            <a href="/kontakt/" class="btn btn-g" data-magnetic>Poproś o wycenę</a>
          </div>
        </aside>
      </div>
    </div>

    <section class="kb-more" aria-labelledby="kb-more-h">
      <div class="wrap">
        <h2 id="kb-more-h" class="h">Zobacz więcej w bazie wiedzy</h2>
        <p><a href="/baza-wiedzy/" class="btn btn-d">Wszystkie artykuły</a></p>
      </div>
    </section>
  </main>

  <script>
    // podświetlanie aktualnej sekcji w spisie treści
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc] a'));
    const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean) as HTMLElement[];
    if (links.length && 'IntersectionObserver' in window) {
      const on = (id: string) => links.forEach((a) => a.classList.toggle('is-on', decodeURIComponent(a.hash.slice(1)) === id));
      const io = new IntersectionObserver((es) => {
        const vis = es.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (vis) on(vis.target.id);
      }, { rootMargin: '-110px 0px -65% 0px' });
      heads.forEach((h) => io.observe(h));
      on(heads[0]?.id ?? '');
    }
  </script>
</Base>
