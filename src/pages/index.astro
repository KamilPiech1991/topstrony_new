---
import Base from '../layouts/Base.astro';
import HomeMain from '../components/gen/HomeMain.astro';
import v from '../data/pages/home.json';
import { faqLd, SITE } from '../data/site';

const ld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': SITE + '/#website', name: 'top.strony', url: SITE + '/', inLanguage: 'pl-PL' },
  faqLd(v.faqs),
];
---
<Base v={v} page="home" path="/" jsonLd={ld}
  title="Strony internetowe Piaseczno i Warszawa, SEO i reklamy | top.strony"
  description="Strony internetowe i sklepy dla firm z Piaseczna, Warszawy i okolic. SEO, AEO i GEO, Google Ads, Meta Ads i social media. Biuro w Piasecznie, wycena w 24 h. Tel. 501 784 882.">
  <HomeMain v={v} />
</Base>
