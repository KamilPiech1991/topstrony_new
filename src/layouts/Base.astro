---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/gen/Header.astro';
import Footer from '../components/gen/Footer.astro';
import { SITE, business } from '../data/site';

interface Props {
  v: Record<string, any>;
  title: string;
  description: string;
  path: string;
  image?: string;
  jsonLd?: object[];
  page?: string;
  noindex?: boolean;
}
const { v, title, description, path, image = '/img/og-topstrony.jpg', jsonLd = [], page = 'home', noindex = false } = Astro.props;
const canonical = new URL(path, SITE).href;
const ogImage = new URL(image, SITE).href;
const ld = [business, ...jsonLd];
// pozycja "Baza wiedzy" w menu (przed "Kontakt")
const withKb = (arr: any[] | undefined) => {
  if (!arr || arr.some((l) => l.k === 'baza')) return arr;
  const cur = page === 'baza';
  const item = { t: 'Baza wiedzy', href: '/baza-wiedzy/', k: 'baza', cls: cur ? 'is-cur' : '', cur: cur ? 'page' : 'false' };
  const at = arr.findIndex((l) => l.k === 'kontakt');
  const out = [...arr];
  out.splice(at < 0 ? out.length : at, 0, item);
  return out.map((l, i) => ({ ...l, i: String(i) }));
};
const hv = { ...v, navRest: withKb(v.navRest), navLinks: withKb(v.navLinks) };
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <meta name="theme-color" content="#0A0E0B" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:site_name" content="top.strony" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" href="/img/top-strony-logo-white.webp" as="image" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <slot name="head" />
</head>
<body>
  <div id="top" class="ts" data-theme="dark" data-page={page}>
    <script is:inline>
      try { var t = localStorage.getItem('ts-theme'); if (t === 'light' || t === 'dark') document.getElementById('top').dataset.theme = t; } catch (e) {}
    </script>
    <div class="prog" aria-hidden="true"></div>
    <a href="#main" class="sr-only">Przejdź do treści</a>
    <Header v={hv} />
    <slot />
    <Footer v={hv} />
  </div>
  <script>
    import '../scripts/app';
  </script>
</body>
</html>
