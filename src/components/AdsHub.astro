---
// Dwa kafle: Google Ads i Meta Ads (strona /uslugi/kampanie-google-meta-ads/)
const tiles = [
  { k: 'g', href: '/uslugi/google-ads/', logo: '/img/logos/google-ads.svg', lw: 272, lh: 105, alt: 'Google Ads',
    img: '/img/ads/kafel-google-ads.webp', imgAlt: 'Telefon z reklamą Sponsorowane i mapą w wynikach wyszukiwania Google',
    h: 'Klient szuka, Ty jesteś pierwszy', p: 'Reklamy w wyszukiwarce, Mapach, Zakupach i na YouTube. Dla osób, które już wpisują Twoją usługę w Google.',
    tags: ['Wyszukiwarka', 'Mapy', 'Zakupy', 'YouTube'], cta: 'Zobacz Google Ads' },
  { k: 'm', href: '/kontakt/', logo: '/img/logos/meta.svg', lw: 512, lh: 106, alt: 'Meta',
    img: '/img/ads/kafel-meta-ads.webp', imgAlt: 'Kobieta przegląda na telefonie krótkie filmy z reklamą sponsorowaną',
    h: 'Klient przewija, Ty go zatrzymujesz', p: 'Reklamy na Facebooku i Instagramie: Reels, Stories, formularze kontaktowe i sprzedaż. Dla osób, które jeszcze nie szukają.',
    tags: ['Facebook', 'Instagram', 'Reels', 'Lead Ads'], cta: 'Zapytaj o Meta Ads' },
];
---
<section id="rodzaje-reklam" class="sec ah-sec" aria-labelledby="ah-h">
  <div class="wrap">
    <p class="eyebrow scr">Google czy Meta</p>
    <h2 id="ah-h" class="h h2 split">Gdzie chcesz pokazać reklamę?</h2>
    <div class="ah-grid">
      {tiles.map((t, i) => (
        <a href={t.href} class={`ah-tile ah-${t.k} rv ${i ? 'd1' : ''}`}>
          <span class="ah-media"><img src={t.img} alt={t.imgAlt} width="1168" height="880" loading="lazy" decoding="async" /></span>
          <span class="ah-logo"><img src={t.logo} alt={t.alt} width={t.lw} height={t.lh} loading="lazy" decoding="async" /></span>
          <span class="ah-body">
            <b class="ah-h">{t.h}</b>
            <span class="ah-p">{t.p}</span>
            <span class="ah-tags">{t.tags.map((x) => <span>{x}</span>)}</span>
            <span class="ah-cta">{t.cta} <i aria-hidden="true">→</i></span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .ah-grid{margin-top:40px;display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .ah-sec a,.ah-sec a *{text-decoration:none!important}
  .ah-tile{--c1:#4285F4;--c2:#34A853;--c3:#FBBC04;position:relative;display:flex;flex-direction:column;min-height:580px;border-radius:32px;overflow:hidden;isolation:isolate;color:#fff!important;background:#111;border:1px solid var(--line);transition:transform .5s cubic-bezier(.2,.7,.2,1),box-shadow .5s}
  .ah-m{--c1:#0064E1;--c2:#0082FB;--c3:#5BA4FF}
  .ah-media{position:absolute;inset:0;z-index:-2}
  .ah-media img{width:100%;height:100%;object-fit:cover;object-position:50% 20%;transform:scale(1.04);transition:transform 1.2s cubic-bezier(.2,.7,.2,1)}
  .ah-tile::before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(8,10,8,.05) 0%,rgba(8,10,8,.1) 32%,rgba(8,10,8,.72) 58%,rgba(8,10,8,.9) 76%,rgba(8,10,8,.96) 100%)}
  .ah-tile::after{content:"";position:absolute;left:0;right:0;bottom:0;height:4px;background:linear-gradient(90deg,var(--c1),var(--c2),var(--c3));transform:scaleX(.18);transform-origin:left;transition:transform .7s cubic-bezier(.2,.7,.2,1)}
  .ah-tile:hover,.ah-tile:focus-visible{transform:translateY(-6px);box-shadow:0 30px 60px -30px color-mix(in srgb,var(--c1) 70%,transparent)}
  .ah-tile:hover .ah-media img,.ah-tile:focus-visible .ah-media img{transform:scale(1.1)}
  .ah-tile:hover::after,.ah-tile:focus-visible::after{transform:scaleX(1)}
  .ah-logo{align-self:flex-start;margin:28px 0 0 28px;display:grid;place-items:center;height:62px;padding:0 18px;border-radius:18px;background:#fff;box-shadow:0 12px 30px rgba(0,0,0,.25);animation:ah-bob 5s ease-in-out infinite}
  .ah-m .ah-logo{animation-delay:-2.5s}
  .ah-logo img{height:38px;width:auto;display:block}
  .ah-m .ah-logo img{height:26px}
  @keyframes ah-bob{50%{transform:translateY(-5px)}}
  .ah-body{margin-top:auto;padding:28px;display:flex;flex-direction:column;gap:12px}
  .ah-sec .ah-h{font-family:Poppins,Inter,sans-serif;font-size:clamp(24px,2.6vw,34px);line-height:1.15;color:#fff!important}
  .ah-sec .ah-p{font-size:16px;line-height:1.6;color:rgba(255,255,255,.85)!important;max-width:480px}
  .ah-tags{display:flex;flex-wrap:wrap;gap:6px}
  .ah-sec .ah-tags span{font-size:12.5px;padding:5px 11px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);color:#fff!important;backdrop-filter:blur(6px)}
  .ah-sec .ah-cta{align-self:flex-start;margin-top:6px;display:inline-flex;align-items:center;gap:10px;padding:12px 20px;border-radius:999px;background:#fff;color:#0A0E0B!important;font-weight:700;font-size:15px;transition:background .3s,color .3s}
  .ah-cta i{font-style:normal;display:inline-block;transition:transform .35s}
  .ah-sec .ah-tile:hover .ah-cta{background:var(--c1);color:#fff!important}
  .ah-tile:hover .ah-cta i{transform:translateX(5px)}
  @media (max-width:900px){.ah-grid{grid-template-columns:1fr}.ah-tile{min-height:500px}}
  @media (max-width:520px){.ah-tile{min-height:460px;border-radius:24px}.ah-logo{margin:20px 0 0 20px;height:52px}.ah-logo img{height:30px}.ah-m .ah-logo img{height:21px}.ah-body{padding:20px}.ah-sec .ah-p{font-size:15px}}
  @media (prefers-reduced-motion:reduce){.ah-logo{animation:none}.ah-media img,.ah-tile{transition:none}}
</style>
