---
// Kafelki: rodzaje reklam Google Ads i Meta Ads (strona /uslugi/kampanie-google-meta-ads/)
const G = '/uslugi/google-ads/';
const google = [
  { t: 'Reklama w wyszukiwarce', s: 'Search', d: 'Tekst nad wynikami, gdy klient wpisze Twoją usługę.', href: G + '#reklama-search', i: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-5-5' },
  { t: 'Performance Max', s: 'PMax', d: 'Jedna kampania we wszystkich kanałach Google.', href: G + '#reklama-pmax', i: 'M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z' },
  { t: 'Zakupy Google', s: 'Shopping', d: 'Zdjęcie, cena i sklep jeszcze przed kliknięciem.', href: G + '#reklama-zakupy', i: 'M6 6h15l-1.5 9h-12zM6 6L5 3H2M9 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2zM18 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2' },
  { t: 'Mapy Google', s: 'Lokalnie', d: 'Firma wyróżniona w Mapach z przyciskiem „Zadzwoń”.', href: G + '#reklama-mapy', i: 'M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5' },
  { t: 'YouTube', s: 'Wideo', d: 'Film przed i w trakcie filmów oraz w Shorts.', href: G + '#reklama-youtube', i: 'M4 6h16v12H4zM10 9.5v5l4.5-2.5z' },
  { t: 'Remarketing', s: 'Powrót', d: 'Przypomnienie dla osób, które były na stronie.', href: G + '#reklama-remarketing', i: 'M3 12a9 9 0 1 0 3-6.7M3 4v5h5' },
  { t: 'Sieć reklamowa', s: 'Display', d: 'Banery na stronach, w aplikacjach i Gmailu.', href: G + '#reklama-display', i: 'M3 4h18v12H3zM8 20h8M12 16v4' },
  { t: 'Demand Gen', s: 'Popyt', d: 'Wizualne reklamy w YouTube, Gmailu i Discover.', href: G + '#reklama-demand-gen', i: 'M13 2L3 14h9l-1 8 10-12h-9z' },
];
const meta = [
  { t: 'Reklamy kontaktowe', s: 'Lead Ads', d: 'Formularz w Facebooku i Instagramie wypełniony w kilka sekund.', i: 'M4 4h16v16H4zM8 9h8M8 13h8M8 17h5' },
  { t: 'Sprzedaż w sklepie', s: 'Advantage+', d: 'Kampanie sprzedażowe i reklamy z katalogu produktów.', i: 'M6 6h15l-1.5 9h-12zM6 6L5 3H2M9 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2zM18 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2' },
  { t: 'Reels i Stories', s: 'Zasięg', d: 'Pionowe wideo, które buduje rozpoznawalność w regionie.', i: 'M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM10 9.5v5l4.5-2.5z' },
  { t: 'Wiadomości', s: 'Messenger · WhatsApp', d: 'Reklama, która otwiera rozmowę z Twoją firmą.', i: 'M21 12a8 8 0 0 1-11.6 7.1L4 21l1.9-5.4A8 8 0 1 1 21 12z' },
  { t: 'Remarketing', s: 'Piksel Meta', d: 'Powrót do osób, które odwiedziły stronę lub profil.', i: 'M3 12a9 9 0 1 0 3-6.7M3 4v5h5' },
  { t: 'Ruch na stronę', s: 'Kliknięcia', d: 'Wejścia na stronę lub landing page z wybranej grupy odbiorców.', i: 'M5 12h14M13 6l6 6-6 6' },
];
---
<section id="rodzaje-reklam" class="sec ah-sec" aria-labelledby="ah-h">
  <div class="wrap">
    <p class="eyebrow scr">Rodzaje reklam</p>
    <h2 id="ah-h" class="h h2 split">Wybierz, gdzie chcesz pokazać reklamę</h2>
    <p class="lead ah-lead">Google Ads trafia do osób, które już szukają usługi. Meta Ads dociera do ludzi na Facebooku i Instagramie, zanim zaczną szukać. Kliknij kafelek, żeby zobaczyć, jak działa dany rodzaj reklamy.</p>
    <div class="ah-grid">
      <div class="ah-panel ah-g rv">
        <div class="ah-head">
          <span class="ah-logo"><img src="/img/logos/google-ads.svg" alt="Google Ads" width="272" height="105" loading="lazy" decoding="async"></span>
          <div><b>Klient szuka, Ty jesteś pierwszy</b><span>Wyszukiwarka, Mapy, YouTube, Gmail</span></div>
          <a class="ah-all" href={G}>Wszystko o Google Ads <span aria-hidden="true">→</span></a>
        </div>
        <ul class="ah-tiles">
          {google.map((x, n) => (
            <li style={`--d:${n * 0.05}s`}>
              <a class="ah-tile" href={x.href}>
                <span class="ah-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={x.i}></path></svg></span>
                <span class="ah-s">{x.s}</span>
                <b>{x.t}</b>
                <small>{x.d}</small>
                <span class="ah-go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="ah-panel ah-m rv d1">
        <div class="ah-head">
          <span class="ah-logo"><img src="/img/logos/meta.svg" alt="Meta" width="512" height="106" loading="lazy" decoding="async"></span>
          <div><b>Klient przewija, Ty go zatrzymujesz</b><span>Facebook, Instagram, Messenger, WhatsApp</span></div>
          <a class="ah-all" href="/kontakt/">Zapytaj o Meta Ads <span aria-hidden="true">→</span></a>
        </div>
        <ul class="ah-tiles">
          {meta.map((x, n) => (
            <li style={`--d:${n * 0.05}s`}>
              <a class="ah-tile" href="/kontakt/" aria-label={`${x.t}: ${x.d} Zapytaj o kampanię`}>
                <span class="ah-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={x.i}></path></svg></span>
                <span class="ah-s">{x.s}</span>
                <b>{x.t}</b>
                <small>{x.d}</small>
                <span class="ah-go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .ah-lead{max-width:780px}
  .ah-sec a,.ah-sec a:hover,.ah-sec a *{text-decoration:none!important}
  .ah-sec .ah-tile,.ah-sec .ah-tile small{color:var(--text)!important}
  .ah-sec .ah-tile b,.ah-sec .ah-all{color:var(--ink)!important}
  .ah-sec .ah-tile .ah-s{color:var(--muted)!important}
  .ah-head>div{display:flex;flex-direction:column;gap:3px}
  .ah-grid{margin-top:44px;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:20px;align-items:start}
  .ah-panel{--c1:#4285F4;--c2:#34A853;--c3:#FBBC04;position:relative;border-radius:30px;padding:26px;background:var(--surface);border:1px solid var(--line);isolation:isolate;overflow:hidden}
  .ah-m{--c1:#0064E1;--c2:#0082FB;--c3:#5BA4FF}
  .ah-panel::before{content:"";position:absolute;inset:-1px;border-radius:inherit;padding:1.5px;background:conic-gradient(from var(--ah-a,0deg),var(--c1),var(--c2),var(--c3),var(--c1));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:.0;transition:opacity .5s;z-index:-1;animation:ah-spin 6s linear infinite}
  .ah-panel:hover::before{opacity:.9}
  .ah-panel::after{content:"";position:absolute;width:340px;height:340px;right:-120px;top:-160px;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--c1) 22%,transparent),transparent 70%);z-index:-1;animation:ah-float 9s ease-in-out infinite}
  @property --ah-a{syntax:'<angle>';inherits:false;initial-value:0deg}
  @keyframes ah-spin{to{--ah-a:360deg}}
  @keyframes ah-float{50%{transform:translate(-30px,24px) scale(1.08)}}
  .ah-head{display:grid;grid-template-columns:auto 1fr;gap:6px 16px;align-items:center;margin-bottom:22px}
  .ah-logo{grid-row:span 2;display:grid;place-items:center;height:64px;padding:0 18px;border-radius:18px;background:#fff;box-shadow:0 10px 26px rgba(0,0,0,.16);animation:ah-bob 5s ease-in-out infinite}
  .ah-logo img{height:38px;width:auto;display:block}
  .ah-m .ah-logo img{height:26px}
  @keyframes ah-bob{50%{transform:translateY(-4px)}}
  .ah-head b{font-family:Poppins,Inter,sans-serif;font-size:18px;color:var(--ink);line-height:1.25}
  .ah-head span{font-size:13.5px;color:var(--muted)}
  .ah-all{grid-column:1/-1;justify-self:start;margin-top:10px;font-size:14px;font-weight:600;color:var(--ink);padding:8px 14px;border-radius:999px;border:1px solid var(--line);transition:border-color .25s,background .25s}
  .ah-all span{display:inline-block;transition:transform .25s}
  .ah-all:hover{border-color:var(--c1);background:color-mix(in srgb,var(--c1) 10%,transparent)}
  .ah-all:hover span{transform:translateX(4px)}
  .ah-tiles{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .js-anim .ah-tiles li{opacity:0;transform:translateY(14px);transition:opacity .6s cubic-bezier(.2,.7,.2,1) calc(var(--d) + .15s),transform .6s cubic-bezier(.2,.7,.2,1) calc(var(--d) + .15s)}
  .js-anim .ah-panel.in .ah-tiles li{opacity:1;transform:none}
  .ah-tile{position:relative;display:flex;flex-direction:column;gap:4px;height:100%;padding:16px 16px 16px;border-radius:18px;background:var(--bg-2);border:1px solid var(--line);color:var(--text);transition:transform .35s cubic-bezier(.2,.7,.2,1),border-color .3s,box-shadow .35s,background .3s;overflow:hidden}
  .ah-tile::after{content:"";position:absolute;inset:auto 0 0 0;height:3px;background:linear-gradient(90deg,var(--c1),var(--c2),var(--c3));transform:scaleX(0);transform-origin:left;transition:transform .45s cubic-bezier(.2,.7,.2,1)}
  .ah-tile:hover,.ah-tile:focus-visible{transform:translateY(-4px);border-color:color-mix(in srgb,var(--c1) 55%,var(--line));box-shadow:0 18px 34px -18px color-mix(in srgb,var(--c1) 60%,transparent);background:var(--surface)}
  .ah-tile:hover::after,.ah-tile:focus-visible::after{transform:scaleX(1)}
  .ah-ic{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;color:#fff;background:linear-gradient(145deg,var(--c1),var(--c2));margin-bottom:8px;transition:transform .4s cubic-bezier(.2,.7,.2,1)}
  .ah-tiles li:nth-child(3n+2) .ah-ic{background:linear-gradient(145deg,var(--c2),var(--c3))}
  .ah-g .ah-tiles li:nth-child(3n+3) .ah-ic{background:linear-gradient(145deg,#EA4335,var(--c3))}
  .ah-ic svg{width:21px;height:21px}
  .ah-tile:hover .ah-ic{transform:rotate(-8deg) scale(1.08)}
  .ah-s{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .ah-tile b{font-family:Poppins,Inter,sans-serif;font-size:16px;line-height:1.25;color:var(--ink)}
  .ah-tile small{font-size:13.5px;line-height:1.5;padding-right:18px}
  .ah-go{position:absolute;top:16px;right:16px;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font-size:15px;color:var(--ink);border:1px solid var(--line);transition:transform .35s,background .3s,color .3s,border-color .3s}
  .ah-tile:hover .ah-go{transform:translateX(3px) rotate(-45deg);background:var(--c1);border-color:var(--c1);color:#fff}
  @media (max-width:1000px){.ah-grid{grid-template-columns:1fr}}
  @media (max-width:520px){.ah-panel{padding:18px;border-radius:24px}.ah-tiles{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.ah-tile{padding:14px}.ah-tile small,.ah-go{display:none}.ah-tile b{font-size:14.5px}.ah-ic{width:36px;height:36px}.ah-head{grid-template-columns:1fr}.ah-logo{grid-row:auto;justify-self:start}}
  @media (prefers-reduced-motion:reduce){.ah-panel::before,.ah-panel::after,.ah-logo{animation:none}.js-anim .ah-tiles li{opacity:1;transform:none;transition:none}}
</style>

<script>
  const panels = document.querySelectorAll<HTMLElement>('.ah-panel');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.15 });
    panels.forEach((p) => io.observe(p));
  } else panels.forEach((p) => p.classList.add('in'));
</script>
