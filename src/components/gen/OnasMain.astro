---
// Generated from the top.strony design (tools/dc2astro.py). 
const { v } = Astro.props;
---
<main id="main">
  <!-- ============ O NAS: HERO ============ -->
  <section class="sec onas-hero" aria-labelledby="onas-h1">
    <div class="wrap onas-grid">
      <div>
        <p class="eyebrow h-in">O nas</p>
        <h1 id="onas-h1" class="h h-in onas-h1">Cześć, jestem Kamil. Prowadzę <span style="color: #60AD26">top.strony</span>.</h1>
        <p class="lead h-in">Od 8 lat łączę IT i marketing. Projektuję strony i sklepy, pozycjonuję je w Google i w odpowiedziach AI, prowadzę kampanie i social media dla firm z Piaseczna, Warszawy i całej Polski.</p>
        <p class="lead h-in" style="margin-top: 14px">top.strony to mała agencja z założenia: rozmawiasz bezpośrednio ze mną, a nad projektem pracują stali specjaliści od grafiki, treści i programowania. Bez przekazywania między działami i bez obietnic, których nie da się zmierzyć.</p>
        <div class="hero-ctas h-in" style="justify-content: flex-start">
          <a data-magnetic href="/kontakt/" class="btn btn-g">Umów bezpłatną konsultację</a>
          <a data-magnetic href="/realizacje/" class="btn btn-o">Zobacz realizacje</a>
        </div>
      </div>
      <figure class="onas-photo m-reveal rv" data-cursor="Cześć!">
        <span class="m-mask"><span class="m-scrub"><img decoding="async" src="/img/kamil-piech-k2photo.webp" alt="Kamil Piech, założyciel top.strony, w fotelu ze smartfonem" width="1100" height="1650"></span></span>
        <figcaption class="onas-tag"><b>Kamil Piech</b><span>założyciel · strategia, SEO, kampanie</span></figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ LICZBY ============ -->
  <section class="sec alt deco-bars" aria-labelledby="onas-liczby" style="padding-top: 96px; padding-bottom: 96px">
    <div class="wrap">
      <h2 id="onas-liczby" class="eyebrow scr" style="margin-bottom: 28px">top.strony w liczbach</h2>
      <div class="nums stg">
        {(v.facts ?? []).map((fa) => (<Fragment>
          <div class="num"><div class="num-v"><span class="cnt">{fa?.v}</span><sup>{fa?.s}</sup></div><div class="num-l">{fa?.l}</div></div>
        </Fragment>))}
      </div>
    </div>
  </section>

  <!-- ============ WARTOŚCI ============ -->
  <section class="sec deco-rings" aria-labelledby="onas-war">
    <div class="wrap">
      <div class="head rv">
        <div>
          <p class="eyebrow scr">Jak myślimy</p>
          <h2 id="onas-war" class="h h2 split"><span class="wm"><span class="wi">Cztery</span></span> <span class="wm"><span class="wi">zasady,</span></span> <span class="wm"><span class="wi">których</span></span> <span class="wm"><span class="wi">się</span></span> <span class="wm"><span class="wi">trzymamy</span></span></h2>
        </div>
      </div>
      <div class="pains stg">
        {(v.values ?? []).map((vl) => (<Fragment>
          <article class="card hov pain"><div class="pain-q"><span class="stack-n">{vl?.n}</span></div><h3 class="h" style="margin: 0; font-size: 21px; font-weight: 600">{vl?.t}</h3><p class="pain-a" style="border-top: 0; padding-top: 0">{vl?.d}</p></article>
        </Fragment>))}
      </div>
    </div>
  </section>

  <!-- ============ ZESPÓŁ ============ -->
  <section class="sec alt deco-wave deco-r" aria-labelledby="onas-team">
    <div class="wrap team">
      <div class="founder rv"><img decoding="async" class="founder-img" src="/img/kamil-piech-k3photo.webp" alt="Kamil Piech, portret" width="1000" height="1356" loading="lazy"></div>
      <div class="rv d1">
        <p class="eyebrow scr">Zespół</p>
        <h2 id="onas-team" class="h h2 split"><span class="wm"><span class="wi">Kto</span></span> <span class="wm"><span class="wi">pracuje</span></span> <span class="wm"><span class="wi">nad</span></span> <span class="wm"><span class="wi">Twoim</span></span> <span class="wm"><span class="wi">projektem</span></span></h2>
        <p class="lead">Jeden opiekun i stały zespół specjalistów. Każdy z nas zna projekt od początku, więc nie tłumaczysz wszystkiego od nowa.</p>
        <div class="roles stg">
          {(v.roles ?? []).map((ro) => (<Fragment>
            <div class="card role"><span class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ro?.icon}></path></svg></span><div><b>{ro?.t}</b><span>{ro?.d}</span></div></div>
          </Fragment>))}
        </div>
        <p class="eyebrow" style="margin: 30px 0 0">Ukończone kursy z certyfikatem</p>
        <div class="certs" style="margin-top: 12px">
          {(v.certs ?? []).map((ce) => (<Fragment><span class="cert"><i></i>{ce}</span></Fragment>))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ KLIENCI ============ -->
  <section class="sec" aria-labelledby="onas-kl" style="padding-bottom: 60px">
    <div class="wrap"><h2 id="onas-kl" class="eyebrow scr" style="text-align: center">Zaufali nam</h2></div>
    <div class="hero-strip" style="margin-top: 20px; border-top: 0">
      <div class="marquee">
        {(v.logosLoop ?? []).map((l) => (<Fragment>
          <span class="mlogo" role="img" aria-label={l?.name} style={l?.mask}></span>
        </Fragment>))}
      </div>
    </div>
  </section>

  <!-- ============ BANER ============ -->
  <section class="cta-sec" aria-labelledby="onas-cta">
    <div class="wrap">
      <div class="cta cta-keep rv">
        <div class="cta-txt">
          <span class="cta-k">Porozmawiajmy</span>
          <h2 id="onas-cta" class="cta-h">Opowiedz mi o swojej firmie</h2>
          <p class="cta-p">W 20 minut ustalimy, co da najszybszy efekt: nowa strona, SEO, kampanie czy social media. Bez zobowiązań.</p>
          <div class="cta-row">
            <a data-magnetic href="tel:+48501784882" class="btn btn-w">Zadzwoń: 501 784 882</a>
            <a href="/kontakt/" class="cta-tel">albo napisz →</a>
          </div>
        </div>
        <div class="cta-img"><img decoding="async" src="/img/kamil-piech-k3cut.webp" alt="Kamil Piech, założyciel top.strony" width="738" height="1000" loading="lazy"><div class="cta-badge" aria-hidden="true"><i></i><span><b>Odpowiadam w 24 h</b>pon.–pt. 9:00–20:00</span></div></div>
      </div>
    </div>
  </section>
  </main>
