---
// Generated from the top.strony design (tools/dc2astro.py). 
const { v } = Astro.props;
---
<!-- ============ 18. STOPKA ============ -->
  <footer class="foot">
    <div class="wrap">
      <div class="foot-grid">
        <div style="display: flex; flex-direction: column; gap: 18px">
          <a href="/" class="logo" aria-label="top.strony – strona główna"><img decoding="async" loading="lazy" class="logo-img logo-d" src="/img/top-strony-logo-white-300.webp" alt="top.strony" width="300" height="92"><img decoding="async" loading="lazy" class="logo-img logo-l" src="/img/top-strony-logo-ink-300.webp" alt="top.strony" width="300" height="92"></a>
          <p style="margin: 0; font-size: 14px; line-height: 1.7; max-width: 320px">Strony i sklepy, SEO, AEO i GEO, Google Ads, Meta Ads, social media i branding dla firm z Piaseczna, Warszawy i całej Polski.</p>
          <div class="soc">
            {(v.socials ?? []).map((so) => (<Fragment>
              <a href={so?.href} target="_blank" rel="noopener" aria-label={so?.t}><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={so?.d}></path></svg></a>
            </Fragment>))}
          </div>
        </div>
        {(v.footCols ?? []).map((fc) => (<Fragment>
          <nav aria-label={fc?.t}>
            <div class="foot-t">{fc?.t}</div>
            <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column">
              {(fc?.links ?? []).map((lk) => (<Fragment><li><a href={lk?.href}>{lk?.t}</a></li></Fragment>))}
            </ul>
          </nav>
        </Fragment>))}
      </div>
      <div class="foot-bot">
        <span>© 2026 top.strony · Qamitech Kamil Piech</span>
        <span style="display: flex; gap: 20px"><a href="/polityka-prywatnosci/">Polityka prywatności</a><a href="/polityka-prywatnosci/#cookies">Cookies</a><button type="button" class="tlink" style="all: unset; cursor: pointer; color: var(--acc-t); font-weight: 600" data-act="theme">{v.themeLabel}</button></span>
      </div>
    </div>
  </footer>

  <!-- ============ SZYBKI KONTAKT (mobile: bottom sheet · desktop: modal) ============ -->
  <div data-if="fab-closed" hidden={!v.fabClosed}>
    <button type="button" class="fab-main" data-act="fab" aria-haspopup="dialog" aria-label="Szybki kontakt">
      <span class="fab-ring" aria-hidden="true"></span>
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-12.4 7.6L3 21l1.4-5.4A8.5 8.5 0 1 1 21 12z"></path><path d="M8 11h.01M12 11h.01M16 11h.01"></path></svg>
      <span class="fab-txt">Porozmawiajmy</span>
    </button>
  </div>
  <div data-if="fab-open" hidden={!v.fabOpen}>
    <div class="qc" role="dialog" aria-modal="true" aria-labelledby="qc-h">
      <div class="qc-back" data-act="fab" aria-hidden="true"></div>
      <div class="qc-panel">
        <div class="qc-grab" aria-hidden="true"></div>
        <div class="qc-head">
          <span class={`qc-av ${v.statusCls ?? ''}`} title={v.statusLabel}><img decoding="async" src="/img/kamil-piech-face2.webp" alt="" width="56" height="56"><i aria-hidden="true"></i></span>
          <div>
            <h2 id="qc-h" class="h">Jak możemy Ci pomóc?</h2>
            <p><span class={`qc-st ${v.statusCls ?? ''}`}>{v.statusLabel}</span> · {v.statusNote}</p>
          </div>
          <button type="button" class="icon-btn qc-x" data-act="fab" aria-label="Zamknij"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
        </div>
        <div class="qc-grid">
          <a href="tel:+48501784882" class="qc-tile t-tel">
            <span class="qc-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path></svg></span>
            <b>Zadzwoń</b><span>501 784 882</span><small>pon.–pt. 9:00–20:00</small>
          </a>
          <a href="mailto:biuro@topstrony.pl" class="qc-tile t-mail">
            <span class="qc-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg></span>
            <b>Napisz e-mail</b><span>biuro@topstrony.pl</span><small>odpowiedź w 24 h</small>
          </a>
          <a href="/kontakt/" class="qc-tile t-quote" data-act="fab">
            <span class="qc-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg></span>
            <b>Bezpłatna wycena</b><span>formularz, 2 minuty</span><small>stała cena w umowie</small>
          </a>
          <a href="#asystent-ai" class="qc-tile t-ai">
            <span class="qc-badge">24/7</span>
            <span class="qc-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.2 4.8L19 10l-4.8 2.2L12 17l-2.2-4.8L5 10l4.8-2.2z"></path><path d="M19 16l.9 2.1L22 19l-2.1.9L19 22l-.9-2.1L16 19l2.1-.9z"></path></svg></span>
            <b>Konsultant AI</b><span>odpowie od razu</span><small>o każdej porze, także w weekend</small>
          </a>
        </div>
        <a href="https://m.me/topstronypl" target="_blank" rel="noopener" class="qc-foot">Wolisz Messengera? <span class="acc-t">Napisz na Facebooku →</span></a>
      </div>
    </div>
  </div>
