---
// Generated from the top.strony design (tools/dc2astro.py). 
const { v } = Astro.props;
---
<!-- ============ 1. HEADER ============ -->
  <header class="hdr">
    <div class="wrap hdr-in">
      <a href="/" class="logo" aria-label="top.strony – strona główna">
        <img class="logo-img logo-d" src="/img/top-strony-logo-white-300.webp" alt="top.strony" width="300" height="92" fetchpriority="high"><img decoding="async" class="logo-img logo-l" src="/img/top-strony-logo-ink-300.webp" alt="top.strony" width="300" height="92">
      </a>
      <nav class="nav" aria-label="Menu główne">
        <button type="button" class={`nav-mega-btn ${v.megaBtnCls ?? ''}`} data-mega data-act="mega-toggle" aria-expanded={v.megaExp} aria-controls="mega-uslugi">Usługi<svg class="nav-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></button>
        {(v.navRest ?? []).map((nl) => (<Fragment>
          <a href={nl?.href} class={nl?.cls} aria-current={nl?.cur}>{nl?.t}</a>
        </Fragment>))}
      </nav>
      <div class="hdr-act">
        <a href="tel:+48501784882" class="hdr-tel hide-m" aria-label="Zadzwoń: 501 784 882"><svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="#60AD26" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path></svg><span>501 784 882</span></a>
        <button type="button" class="icon-btn" data-act="theme" aria-label={v.themeLabel} aria-pressed={v.isLight}>
          <svg class="th-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          <svg class="th-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        </button>
        <a data-magnetic href="/kontakt/" class="btn btn-g btn-sm hide-m">Bezpłatna wycena</a>
        <button type="button" class="icon-btn burger" data-act="menu-open" aria-label="Otwórz menu" aria-expanded={v.menuExp}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"></path></svg>
        </button>
      </div>
    </div>
    <div id="mega-uslugi" class={`mega ${v.megaCls ?? ''}`} data-mega aria-hidden={v.megaHidden} style={v.megaVars}>
      <div class="wrap mega-in">
        <div class="mega-list" role="list">
          <p class="mega-kick">Usługi top.strony</p>
          {(v.megaItems ?? []).map((m) => (<Fragment>
            <a href={m?.href} class={`mega-it ${m?.cls ?? ''}`} data-msrv={m?.i} role="listitem" data-act="mega-close" style={m?.dl}>
              <span class="mega-ico" style={m?.ibg}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={m?.icon}></path></svg></span>
              <span class="mega-tx"><span class="mega-t">{m?.name}</span><span class="mega-d">{m?.tag}</span></span>
              <svg class="mega-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
          </Fragment>))}
        </div>
        <div class="mega-stage">
          {(v.megaItems ?? []).map((m) => (<Fragment>
            <div class={`mega-pv ${m?.cls ?? ''}`} style={m?.pbg} aria-hidden={m?.hid}>
              <svg class="mega-pv-art" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width=".35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={m?.icon}></path></svg>
              <svg class="mega-pv-chart" viewBox="0 0 400 120" fill="none" stroke="#fff" stroke-width="1.2" aria-hidden="true"><polyline points="0,104 50,92 100,98 150,72 200,78 250,52 300,58 350,30 400,18"></polyline><polyline points="0,114 60,108 120,100 180,96 240,80 300,76 360,60 400,52" stroke-dasharray="4 6" opacity=".6"></polyline></svg>
              <span class="mega-pv-n">{m?.n} / 06<i>{m?.m1}</i><i>{m?.m2}</i></span>
              <p class="mega-pv-t">{m?.title}</p>
              <p class="mega-pv-d">{m?.lead}</p>
              <ul class="mega-sub">
                {(m?.subs ?? []).map((s) => (<Fragment>
                  <li><a href={s === 'Google Ads' ? '/uslugi/google-ads/' : m?.href} tabindex={m?.tab} data-act="mega-close">{s}</a></li>
                </Fragment>))}
              </ul>
              <div class="mega-pv-foot">
                <a href={m?.href} class="mega-pv-btn" tabindex={m?.tab} data-act="mega-close">Zobacz usługę<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
                <span class="mega-pv-note">Bezpłatna wycena w 24 h</span>
              </div>
            </div>
          </Fragment>))}
        </div>
        <div class="mega-side">
          <div class="mega-help">
            <div class="mega-help-top"><img decoding="async" src="/img/kamil-piech-face2.webp" alt="Kamil Piech, opiekun projektów" width="56" height="56"><span class={`mega-dot ${v.statusCls ?? ''}`} title={v.statusLabel}></span></div>
            <p class="mega-help-t">Nie wiesz, od czego zacząć?</p>
            <p class="mega-help-d">20 minut rozmowy z Kamilem. Wskażemy usługę, która najszybciej da zapytania.</p>
            <a href="/kontakt/" class="btn btn-g btn-sm mega-help-btn" data-act="mega-close">Umów konsultację</a>
            <a href="tel:+48501784882" class="mega-help-tel" data-act="mega-close">501 784 882 · pn–pt 9–20</a>
          </div>
          <a href="/#case-sahra-art" class="mega-case" data-act="mega-close">
            <img decoding="async" src="/img/realizacja-sahra-art.webp" alt="Sklep Sahra Art" loading="lazy">
            <span class="mega-case-k">Case study</span>
            <span class="mega-case-t">Sahra Art: sklep, SEO i Google Ads</span>
          </a>
        </div>
      </div>
      <div class="wrap mega-bar">
        <span>Strona, SEO, reklamy i social media w jednym zespole, z jednym opiekunem.</span>
        <a href="/kontakt/" data-act="mega-close">Poproś o bezpłatną wycenę</a>
        <a href="/uslugi/" class="mega-all" data-act="mega-close">Wszystkie usługi →</a>
      </div>
    </div>
    <div class={`mega-veil ${v.megaCls ?? ''}`} aria-hidden="true" data-act="mega-close"></div>
  </header>

  <div data-if="menu" hidden={!v.menuOpen}>
    <div class="mnav" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="mnav-top">
        <a href="/" class="logo" data-act="menu-close" aria-label="top.strony – strona główna"><img decoding="async" class="logo-img logo-d" src="/img/top-strony-logo-white-300.webp" alt="top.strony" width="300" height="92"><img decoding="async" class="logo-img logo-l" src="/img/top-strony-logo-ink-300.webp" alt="top.strony" width="300" height="92"></a>
        <button type="button" class="icon-btn" data-act="menu-close" aria-label="Zamknij menu"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
      </div>
      <nav class="mnav-links" aria-label="Menu mobilne">
        {(v.navLinks ?? []).map((nl) => (<Fragment>
          <a href={nl?.href} data-act="menu-close">{nl?.t}<span aria-hidden="true" class="acc-t">→</span></a>
        </Fragment>))}
      </nav>
      <div class="mnav-cta">
        <a href="/kontakt/" class="btn btn-g" data-act="menu-close">Bezpłatna wycena</a>
        <a href="tel:+48501784882" class="btn btn-o">Zadzwoń: 501 784 882</a>
        <div class="soc" style="justify-content: center; margin-top: 8px">
          {(v.socials ?? []).map((so) => (<Fragment>
            <a href={so?.href} target="_blank" rel="noopener" aria-label={so?.t}><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={so?.d}></path></svg></a>
          </Fragment>))}
        </div>
      </div>
    </div>
  </div>
