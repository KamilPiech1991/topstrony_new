---
// Generated from the top.strony design (tools/dc2astro.py). 
import AiConsultant from '../AiConsultant.astro';
const { v } = Astro.props;
---
<main id="main">
  <!-- ============ KONTAKT: HERO + FORMULARZ ============ -->
  <section id="kontakt" class="sec kt-hero deco-wave" aria-labelledby="kontakt-h" style="background: radial-gradient(900px 520px at 85% 20%, var(--glow), transparent 60%), var(--bg)">
    <div class="wrap contact">
      <div class="rv">
        <p class="eyebrow h-in">Kontakt</p>
        <h1 id="kontakt-h" class="h h-in kt-h1">Porozmawiajmy o Twoim projekcie</h1>
        <p class="lead">Opisz krótko, czego potrzebujesz. Odpowiemy w ciągu 24 godzin z wyceną i propozycją terminu.</p>
        <ul class="c-list">
          <li><a href="tel:+48501784882"><span class="ic"><svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path></svg></span>+48 501 784 882</a></li>
          <li><a href="mailto:biuro@topstrony.pl"><span class="ic"><svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg></span>biuro@topstrony.pl</a></li>
          <li><div><span class="ic"><svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="10" r="2.5"></circle></svg></span><span>Biuro w Piasecznie<small>ul. Strusia 3C lok. 31, 05-500 Piaseczno · pon.–pt. 9:00–20:00</small></span></div></li>
        </ul>
        <div class="soc" style="margin-top: 28px">
          {(v.socials ?? []).map((so) => (<Fragment>
            <a href={so?.href} target="_blank" rel="noopener" aria-label={so?.t}><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={so?.d}></path></svg></a>
          </Fragment>))}
        </div>
        <div class="cities" aria-label="Obszar działania">
          {(v.cities ?? []).map((ci) => (<Fragment><span class="city">{ci}</span></Fragment>))}
        </div>
      </div>
      <form id="formularz" class="card form rv d2" aria-label="Formularz wyceny" name="wycena" method="POST" action="/kontakt/dziekujemy/" data-netlify="true" netlify-honeypot="firma"><input type="hidden" name="form-name" value="wycena"><input type="hidden" name="need" value="Strona www"><p class="sr-only" aria-hidden="true"><label>Firma<input name="firma" tabindex="-1" autocomplete="off"></label></p>
        <div class="h" style="font-size: 24px; font-weight: 700">Bezpłatna wycena</div>
        <fieldset style="border: 0; margin: 0; padding: 0">
          <legend class="ink" style="font-size: 14px; font-weight: 600; margin-bottom: 10px">Czego potrzebujesz?</legend>
          <div style="display: flex; flex-wrap: wrap; gap: 8px">
            {(v.needs ?? []).map((nd) => (<Fragment>
              <button type="button" class="need" data-act="need" data-i={nd.i} aria-pressed={nd?.on}>{nd?.n}</button>
            </Fragment>))}
          </div>
        </fieldset>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px">
          <label class="field">Imię i nazwisko<input type="text" name="name" autocomplete="name" required></label>
          <label class="field">Telefon<input type="tel" name="phone" autocomplete="tel"></label>
        </div>
        <label class="field">E-mail<input type="email" name="email" autocomplete="email" required></label>
        <label class="field">Opisz projekt<textarea name="msg" rows="4" placeholder="Np. strona dla gabinetu, 6 podstron, rezerwacje online"></textarea></label>
        <label style="display: flex; gap: 10px; align-items: flex-start; font-size: 13px; line-height: 1.5"><input type="checkbox" name="rodo" required style="width: 20px; height: 20px; margin: 0; flex: none; accent-color: #60AD26">Wyrażam zgodę na przetwarzanie danych w celu odpowiedzi na zapytanie. Szczegóły w <a href="/polityka-prywatnosci/" class="tlink">polityce prywatności</a>.</label>
        <button type="submit" data-magnetic class="btn btn-g">Wyślij zapytanie</button>
      </form>
    </div>
  </section>

  <AiConsultant />

  <!-- ============ KONTAKT: SPOSOBY ============ -->
  <section class="sec alt deco-bars" aria-labelledby="kt-ways-h">
    <div class="wrap">
      <p class="eyebrow scr">Wybierz, jak Ci wygodnie</p>
      <h2 id="kt-ways-h" class="h h2 split"><span class="wm"><span class="wi">Cztery</span></span> <span class="wm"><span class="wi">drogi</span></span> <span class="wm"><span class="wi">do</span></span> <span class="wm"><span class="wi">jednej</span></span> <span class="wm"><span class="wi">osoby</span></span></h2>
      <div class="kt-ways">
        <a href="tel:+48501784882" class="kt-way rv">
          <span class="kt-ic ki-tel"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path></svg></span>
          <b>Zadzwoń</b><span class="kt-v">501 784 882</span>
          <span class="kt-st"><i class={`kt-dot ${v.statusCls ?? ''}`}></i>{v.statusNote}</span>
        </a>
        <a href="mailto:biuro@topstrony.pl" class="kt-way rv d1">
          <span class="kt-ic ki-mail"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg></span>
          <b>Napisz e-mail</b><span class="kt-v">biuro@topstrony.pl</span>
          <span class="kt-st">Odpowiadamy w ciągu 24 h</span>
        </a>
        <a href="https://m.me/topstronypl" target="_blank" rel="noopener" class="kt-way rv d2">
          <span class="kt-ic ki-msg"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-12.4 7.6L3 21l1.4-5.4A8.5 8.5 0 1 1 21 12z"></path></svg></span>
          <b>Messenger</b><span class="kt-v">top.strony na Facebooku</span>
          <span class="kt-st">Szybkie pytanie bez formularza</span>
        </a>
        <a href="#formularz" class="kt-way rv d3">
          <span class="kt-ic ki-quote"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v16H4zM8 9h8M8 13h8M8 17h5"></path></svg></span>
          <b>Bezpłatna wycena</b><span class="kt-v">Formularz na górze strony</span>
          <span class="kt-st">Wycena i termin w 24 h</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ KONTAKT: CO DALEJ ============ -->
  <section class="sec deco-wave deco-r" aria-labelledby="kt-next-h">
    <div class="wrap">
      <p class="eyebrow scr">Co dzieje się po wysłaniu</p>
      <h2 id="kt-next-h" class="h h2 split"><span class="wm"><span class="wi">Od</span></span> <span class="wm"><span class="wi">wiadomości</span></span> <span class="wm"><span class="wi">do</span></span> <span class="wm"><span class="wi">wyceny</span></span> <span class="wm"><span class="wi">w</span></span> <span class="wm"><span class="wi">trzech</span></span> <span class="wm"><span class="wi">krokach</span></span></h2>
      <ol class="kt-steps">
        <li class="rv"><span class="kt-n">01</span><b>Odpowiedź w 24 h</b><p>Kamil czyta każde zapytanie sam i odpisuje z pytaniami albo propozycją terminu rozmowy.</p></li>
        <li class="rv d1"><span class="kt-n">02</span><b>20 minut rozmowy</b><p>Telefonicznie albo online. Poznajemy firmę, klientów i cel. Bez zobowiązań i bez prezentacji sprzedażowej.</p></li>
        <li class="rv d2"><span class="kt-n">03</span><b>Wycena i harmonogram</b><p>Dostajesz zakres, cenę i terminy na piśmie. Decydujesz w swoim tempie.</p></li>
      </ol>
    </div>
  </section>

  <!-- ============ KONTAKT: BIURO ============ -->
  <section class="sec alt deco-rings deco-l" aria-labelledby="kt-office-h">
    <div class="wrap kt-office">
      <div class="rv">
        <p class="eyebrow scr">Biuro</p>
        <h2 id="kt-office-h" class="h h2 split"><span class="wm"><span class="wi">Spotkajmy</span></span> <span class="wm"><span class="wi">się</span></span> <span class="wm"><span class="wi">w</span></span> <span class="wm"><span class="wi">Piasecznie</span></span></h2>
        <p class="lead">Pracujemy zdalnie z całą Polską, ale chętnie spotkamy się na kawie w biurze. Umów spotkanie telefonicznie, żeby Kamil był na miejscu.</p>
        <dl class="kt-dl">
          <div><dt>Adres</dt><dd>ul. Strusia 3C lok. 31, 05-500 Piaseczno</dd></div>
          <div><dt>Godziny</dt><dd>poniedziałek–piątek, 9:00–20:00</dd></div>
          <div><dt>Firma</dt><dd>Qamitech Kamil Piech</dd></div>
        </dl>
        <a data-magnetic href="https://www.google.com/maps/place/Top+Strony+%E2%80%93+Strony+Internetowe+Piaseczno+i+Warszawa/@52.0776014,21.010337,17z/data=!3m1!4b1!4m6!3m5!1s0x47192fe20fe2da93:0xf50fcb17f005e31a!8m2!3d52.0775981!4d21.0129119!16s%2Fg%2F11jmxz18x3?hl=pl" target="_blank" rel="noopener" class="btn btn-o" style="margin-top: 28px">Wyznacz trasę w Mapach Google</a>
      </div>
      <div class="kt-map rv d2"><iframe title="Mapa Google: Top Strony – Strony Internetowe Piaseczno i Warszawa, ul. Strusia 3C" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1223!2d21.0129119!3d52.0775981!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47192fe20fe2da93%3A0xf50fcb17f005e31a!2sTop%20Strony%20%E2%80%93%20Strony%20Internetowe%20Piaseczno%20i%20Warszawa!5e0!3m2!1spl!2spl!4v1732500000000!5m2!1spl!2spl" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div>
    </div>
  </section>
  </main>
