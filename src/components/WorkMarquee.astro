---
// Dwie zapętlone karuzele z realizacjami (pod hero). Rzędy lekko przechylone, jadą w przeciwne strony.
import all from '../data/realizacje.json';
const items = (all as any[]).map((x) => ({ t: x.t, l: x.l === 'E-commerce' ? 'Sklep' : x.l === 'Strona www' ? 'Strona' : x.l, img: x.img, href: x.slug ? `/realizacje/${x.slug}/` : '/realizacje/' }));
const half = Math.ceil(items.length / 2);
const rows = [items.slice(0, half), items.slice(half)];
---
<section class="wm" aria-label="Wybrane realizacje top.strony">
  {rows.map((row, r) => (
    <div class={`wm-row wm-r${r + 1}`}>
      <div class="wm-track">
        {[0, 1].map((dup) => row.map((x) => (
          <a href={x.href} class="wm-card" tabindex={dup ? -1 : undefined} aria-hidden={dup ? 'true' : undefined}>
            <img src={x.img} alt={dup ? '' : `Realizacja: ${x.t}`} width="860" height="600" loading="lazy" decoding="async">
            <span class="wm-tag"><b>{x.t}</b><small>{x.l}</small></span>
          </a>
        )))}
      </div>
    </div>
  ))}
  <div class="wrap wm-ctl">
    <a href="/realizacje/" class="tlink">Zobacz wszystkie realizacje →</a>
    <button type="button" class="wm-pause" aria-pressed="false" data-wm-pause>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path class="i-pause" d="M9 5v14M15 5v14"/><path class="i-play" d="M7 5l12 7-12 7z"/></svg>
      <span>Zatrzymaj</span>
    </button>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.wm').forEach((wm) => {
    const btn = wm.querySelector<HTMLButtonElement>('[data-wm-pause]');
    btn?.addEventListener('click', () => {
      const on = wm.classList.toggle('is-paused');
      btn.setAttribute('aria-pressed', String(on));
      btn.querySelector('span')!.textContent = on ? 'Wznów' : 'Zatrzymaj';
    });
  });
</script>
<style>
  .wm{position:relative;display:block;width:100%;max-width:100vw;overflow:hidden;padding:24px 0 20px}
  .wm-row{width:112%;margin-left:-6%;overflow:visible}
  .wm-r1{transform:rotate(-2.4deg);margin-bottom:44px}
  .wm-r2{transform:rotate(1.6deg)}
  .wm-track{display:flex;align-items:flex-start;width:max-content;animation:wm-l 70s linear infinite}
  .wm-r2 .wm-track{animation:wm-r 80s linear infinite}
  .wm:hover .wm-track,.wm:focus-within .wm-track,.wm.is-paused .wm-track{animation-play-state:paused}
  .wm-card{position:relative;flex:none;margin-right:20px;width:clamp(250px,24vw,360px);aspect-ratio:860/600;border-radius:18px;overflow:hidden;border:1px solid var(--line);background:var(--surface);box-shadow:0 18px 40px -22px rgba(0,0,0,.55);transition:transform .35s ease}
  .wm-card:hover{transform:translateY(-6px) rotate(-.6deg)}
  .wm-card img{width:100%;height:100%;object-fit:cover;object-position:top;display:block}
  .wm-tag{position:absolute;left:12px;bottom:12px;display:inline-flex;align-items:center;gap:8px;padding:7px 12px;border-radius:999px;background:rgba(10,14,11,.82);backdrop-filter:blur(6px);color:#fff;font-size:13px}
  .wm-tag{white-space:nowrap;max-width:calc(100% - 24px)}
  .wm-tag b{font-weight:600;overflow:hidden;text-overflow:ellipsis}
  .wm-tag small{color:#9BDB66;font-size:12px}
  .wm-ctl{display:flex;justify-content:space-between;align-items:center;margin-top:30px}
  .wm-pause{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;border:1px solid var(--line-2);background:transparent;color:var(--text);font:inherit;font-size:13px;cursor:pointer}
  .wm-pause:hover{border-color:var(--acc);color:var(--ink)}
  .wm-pause .i-play{display:none}
  .wm.is-paused .wm-pause .i-play{display:block}
  .wm.is-paused .wm-pause .i-pause{display:none}
  @keyframes wm-l{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @keyframes wm-r{from{transform:translateX(-50%)}to{transform:translateX(0)}}
  @media (max-width:640px){.wm{padding-top:16px}.wm-r1{margin-bottom:36px}.wm-r1{transform:rotate(-3deg)}.wm-r2{transform:rotate(2deg)}.wm-card{width:240px;margin-right:14px}}
  @media (prefers-reduced-motion:reduce){.wm-track,.wm-r2 .wm-track{animation:none}.wm-row{overflow-x:auto}}
</style>
