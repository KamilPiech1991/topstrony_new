---
// Wspólny szablon podstrony lokalnej (wzorzec: Piaseczno / Warszawa). Dane: src/data/local-cities.ts
import Base from '../layouts/Base.astro';
import v from '../data/pages/srv-strony.json';
import home from '../data/pages/home.json';
import { crumbs, faqLd, SITE, MAP_PLACE, mapEmbed } from '../data/site';
import { CASE_INFO, type LocalCity } from '../data/local-cities';
import { LOCAL_LINKS } from '../data/local';
import '../styles/piaseczno.css';

interface Props { city: LocalCity }
const { city: c } = Astro.props;

const path = `/uslugi/strony-internetowe/${c.slug}/`;
const AUTHOR = { name: 'Kamil Piech', linkedin: 'https://www.linkedin.com/in/kamil-piech-674b7912a/' };
const logos = (home.logosLoop as any[]).slice(0, 15);
const og = `/img/local/og-${c.slug}.jpg`;
const label = `Strony internetowe ${c.nom}`;

const galSrc = [
  ['/img/piaseczno/pz-kawiarnia-spotkanie.webp', 'g-a'],
  ['/img/piaseczno/pz-szkic-makiety.webp', 'g-b'],
  ['/img/piaseczno/pz-biuro-projekt.webp', 'g-c'],
  ['/img/piaseczno/pz-klientka-kwiaciarnia.webp', 'g-d'],
];
const gallery = galSrc.map(([src, cls], i) => ({ src, cls, alt: c.gal[i][0], cap: c.gal[i][1] }));

const offers = [
  { badge: '2–3 tygodnie', h: 'Strona wizytówka', p: `Jedna strona z ofertą, cennikiem, opiniami i kontaktem. Dla firmy usługowej z ${c.gen} i okolic, która chce telefonów od klientów.`, li: ['do 5 sekcji, wersja na telefon', 'formularz i pomiar w GA4', 'SEO lokalne na start'], price: 'od 3 000 zł netto', hot: false },
  { badge: 'Najczęściej wybierana · 1–2 tygodnie', h: 'Serwis firmowy', p: 'Osobna podstrona dla każdej usługi i miejscowości, blog i panel do edycji. Dla firm, które chcą być wysoko na kilka fraz naraz.', li: ['podstrony usług i miejscowości', 'blog i baza wiedzy', 'Astro albo WordPress'], price: 'wycena w 24 h', hot: true },
  { badge: '3–6 tygodni', h: 'Nowa strona w miejsce starej', p: 'Przebudowa strony, która jest wolna albo przestała przynosić zapytania. Przenosimy treści i ustawiamy przekierowania, żeby nie stracić pozycji.', li: ['audyt starej strony', 'mapa przekierowań 301', 'migracja treści i zdjęć'], price: 'wycena w 24 h', hot: false },
];

const steps = [
  c.steps0,
  ['Wycena w 24 godziny', 'Zakres, termin i cena na piśmie. Bez ukrytych dopłat po starcie.'],
  ['Makieta i projekt graficzny', 'Najpierw układ treści, potem wygląd w Figmie. Akceptujesz każdy etap.'],
  ['Kodowanie', 'Astro dla szybkości albo WordPress dla częstej edycji. Wersja testowa jest ukryta przed Google.'],
  c.steps4,
  ['Start, szkolenie i opieka', 'Uruchamiamy stronę na Twojej domenie, pokazujemy panel i zostajemy pod telefonem.'],
];

const reviews = [
  ['Adrian Wojnarowski', 'Zrobili mi porządną stronę internetową, która bez znacznego marketingu generuje zapytania klientów. Polecam z nimi działać.'],
  ['Michał Szymański', 'Świetna realizacja projektu strony dla naszej firmy. Plusy za terminowość oraz świetny kontakt na każdym etapie projektu. Polecam.'],
  ['Damian Konieczny', 'Współpraca z tą firmą to czysta przyjemność. Doskonałe doradztwo, a strona jest elegancka i łatwa w nawigacji.'],
];

const cases = c.cases.map((k) => ({ slug: k.slug, place: k.place, ...CASE_INFO[k.slug] }));
const neighbours = c.neighbours.map((s) => LOCAL_LINKS.find((l) => l.slug === s)!).filter(Boolean);
const faqs = c.faqs;
const cut = c.short.indexOf('. ') + 1;
const shortHead = c.short.slice(0, cut);
const shortRest = c.short.slice(cut).trim();

const ld = [
  { '@context': 'https://schema.org', '@type': 'Service', name: label, serviceType: 'Tworzenie stron internetowych', description: c.description, url: SITE + path,
    provider: { '@id': SITE + '/#business' },
    areaServed: c.areas.map((a) => ({ '@type': 'Place', name: a })),
    offers: { '@type': 'Offer', priceCurrency: 'PLN', price: '3000', priceSpecification: { '@type': 'UnitPriceSpecification', price: '3000', priceCurrency: 'PLN', valueAddedTaxIncluded: false }, description: 'Strona internetowa od 3 000 zł netto' } },
  { '@context': 'https://schema.org', '@type': 'WebPage', name: c.title, url: SITE + path, inLanguage: 'pl-PL', dateModified: '2026-11-25',
    author: { '@type': 'Person', name: AUTHOR.name, url: SITE + '/o-nas/', sameAs: [AUTHOR.linkedin] }, primaryImageOfPage: SITE + og, image: gallery.map((g) => SITE + g.src),
    about: { '@type': 'City', name: c.nom, containedInPlace: { '@type': 'AdministrativeArea', name: 'Województwo mazowieckie' } } },
  faqLd(faqs),
  crumbs([['Strona główna', '/'], ['Usługi', '/uslugi/'], ['Strony internetowe', '/uslugi/strony-internetowe/'], [label, path]]),
];
---
<Base v={v} page={`local-${c.slug}`} path={path} jsonLd={ld} title={c.title} description={c.description} image={og}>
  <main id="main" class="pz">
  <section class="pz-hero" aria-labelledby="pz-h1">
    <img class="pz-hero-bg" src={c.hero.src} alt={c.hero.alt} width="2000" height="1333" fetchpriority="high" decoding="async">
    <div class="pz-hero-ov" aria-hidden="true"></div>
    <div class="wrap pz-hero-in">
      <nav class="pz-crumbs" aria-label="Okruszki"><ol><li><a href="/">Strona główna</a></li><li><a href="/uslugi/">Usługi</a></li><li><a href="/uslugi/strony-internetowe/">Strony internetowe</a></li><li aria-current="page">{label}</li></ol></nav>
      <p class="pz-pin"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8FD35A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>{c.pin}</p>
      <h1 id="pz-h1" class="pz-h1" data-gs="hero">{label}</h1>
      <p class="pz-sub" data-gs="hero">{c.sub}</p>
      <p class="pz-lead" data-gs="hero">{c.lead}</p>
      <div class="pz-cta" data-gs="hero">
        <a data-magnetic href="/kontakt/" class="btn btn-g">Bezpłatna wycena w 24 h <span aria-hidden="true">→</span></a>
        <a href="tel:+48501784882" class="pz-ghost">Zadzwoń: 501 784 882</a>
      </div>
      <ul class="pz-stats" data-gs="hero">
        <li><b>5,0 ★</b><span>średnia z 20 opinii w Google</span></li>
        <li><b>35</b><span>stron i sklepów w portfolio</span></li>
        <li><b>od 3 000 zł</b><span>netto za stronę internetową</span></li>
        <li><b>1–3 tyg.</b><span>od rozmowy do startu strony</span></li>
      </ul>
    </div>
  </section>

  <section class="sec pz-short" aria-labelledby="pz-skrot">
    <div class="wrap">
      <div class="pz-answer rv">
        <div>
          <p id="pz-skrot" class="pz-k">W skrócie</p>
          <p><strong>{shortHead}</strong> {shortRest}</p>
        </div>
        <dl class="pz-nap">
          <div><dt>Biuro</dt><dd>ul. Strusia 3C lok. 31, 05-500 Piaseczno</dd></div>
          <div><dt>Dojazd</dt><dd>{c.dojazd}</dd></div>
          <div><dt>Godziny</dt><dd>pon.–pt. 9:00–20:00</dd></div>
          <div><dt>Cena</dt><dd>od 3 000 zł netto</dd></div>
          <div><dt>Telefon</dt><dd><a href="tel:+48501784882">501 784 882</a></dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="pz-logos" aria-labelledby="pz-logos-h">
    <div class="wrap">
      <p id="pz-logos-h" class="pz-logos-h">Zaufali nam przedsiębiorcy z Mazowsza i całej Polski</p>
    </div>
    <div class="pz-mq">
      <div class="marquee">
        {[...logos, ...logos].map((l: any) => (<span class="mlogo" role="img" aria-label={l.name} style={l.mask}></span>))}
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="pz-why">
    <div class="wrap">
      <p class="eyebrow scr">Agencja z Piaseczna</p>
      <h2 id="pz-why" class="h h2 split">{c.whyH}</h2>
      <p class="lead pz-narrow">{c.whyLead}</p>
      <div class="pz-grid4">
        {c.why.map((w, i) => (
          <article class="pz-card rv" style={`transition-delay:${i * 0.06}s`}>
            <span class="pz-ic" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={w[2]}></path></svg></span>
            <h3 class="h">{w[0]}</h3>
            <p>{w[1]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec pz-gal-sec" aria-labelledby="pz-gal">
    <div class="wrap">
      <p class="eyebrow scr">Jak wygląda współpraca</p>
      <h2 id="pz-gal" class="h h2 split">{c.galH}</h2>
      <p class="lead pz-narrow">{c.galLead}</p>
      <div class="pz-gal">
        {gallery.map((g) => (
          <figure class={`pz-gfig ${g.cls}`} data-gs="reveal">
            <div class="pz-gimg"><img src={g.src} alt={g.alt} width="1344" height="752" loading="lazy" decoding="async"></div>
            <figcaption>{g.cap}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="oferta" class="sec alt" aria-labelledby="pz-off">
    <div class="wrap">
      <p class="eyebrow scr">Co robimy</p>
      <h2 id="pz-off" class="h h2 split">Tworzenie stron internetowych w {c.loc}: co robimy</h2>
      <div class="pz-grid3">
        {offers.map((o, i) => (
          <article class={`pz-offer rv ${o.hot ? 'is-hot' : ''}`} style={`transition-delay:${i * 0.06}s`}>
            <span class="pz-badge">{o.badge}</span>
            <h3 class="h">{o.h}</h3>
            <p>{o.p}</p>
            <ul>{o.li.map((x) => <li>{x}</li>)}</ul>
            <p class="pz-price">{o.price}</p>
          </article>
        ))}
      </div>
      <p class="pz-note rv">Sprzedajesz online? Zobacz <a href="/uslugi/sklepy-internetowe/">sklepy internetowe</a>. Strona już jest, ale nikt jej nie znajduje? Zobacz <a href="/uslugi/pozycjonowanie-seo/">pozycjonowanie SEO</a>. Pełny zakres usługi opisujemy na stronie <a href="/uslugi/strony-internetowe/">tworzenie stron internetowych</a>.</p>
    </div>
  </section>

  <section class="sec" aria-labelledby="pz-ind">
    <div class="wrap">
      <p class="eyebrow scr">Dla kogo</p>
      <h2 id="pz-ind" class="h h2 split">{c.indH}</h2>
      <p class="lead pz-narrow">{c.indLead}</p>
      <div class="pz-grid3">
        {c.ind.map((x, i) => (
          <article class="pz-card rv" style={`transition-delay:${i * 0.06}s`}>
            <h3 class="h">{x[0]}</h3>
            <p><em>{x[1]}</em></p>
            <p>{x[2]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec alt" aria-labelledby="pz-proc">
    <div class="wrap">
      <p class="eyebrow scr">Jak pracujemy</p>
      <h2 id="pz-proc" class="h h2 split">Od rozmowy do strony w 6 krokach</h2>
      <ol class="pz-flow" data-gs="steps">
        {steps.map((s, i) => (
          <li class={`pz-st ${i % 2 ? 'is-r' : 'is-l'}`} style={`--i:${i}`}>
            <span class="pz-bignum" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="pz-node" aria-hidden="true">{i + 1}</span>
            <div class="pz-stc"><small>Krok {i + 1} z {steps.length}</small><h3 class="h">{s[0]}</h3><p>{s[1]}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec" aria-labelledby="pz-seo">
    <div class="wrap pz-split">
      <div class="rv">
        <p class="eyebrow scr">SEO lokalne w cenie</p>
        <h2 id="pz-seo" class="h h2 split">{c.seoH}</h2>
        <p class="lead">{c.seoLead}</p>
        <ul class="pz-checks">
          {c.seo.map((x) => (<li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>{x}</li>))}
        </ul>
      </div>
      <div class="pz-area rv d1">
        <h3 class="h">Gdzie pracujemy</h3>
        <p>{c.areaNote}</p>
        <ul data-gs="chips">{c.areas.map((a, i) => <li class={i === 0 ? 'is-main' : ''}>{a}</li>)}</ul>
        <p class="pz-note">Obsługujemy też: {neighbours.map((n, i) => (<Fragment>{i > 0 ? ', ' : ''}<a href={n.href}>{n.label.toLowerCase()}</a></Fragment>))}.</p>
      </div>
    </div>
  </section>

  <section id="realizacje" class="sec alt" aria-labelledby="pz-real">
    <div class="wrap">
      <p class="eyebrow scr">Realizacje</p>
      <h2 id="pz-real" class="h h2 split">{c.casesH}</h2>
      <div class="pz-grid3">
        {cases.map((k, i) => (
          <a href={`/realizacje/${k.slug}/`} class="pz-case rv" style={`transition-delay:${i * 0.06}s`}>
            <img src={k.img} alt={`Strona ${k.h}`} width="1200" height="750" loading="lazy" decoding="async">
            <span class="pz-case-b"><small>{k.place}</small><b>{k.h}</b><span>{k.p}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="opinie" class="sec alt deco-wave deco-alt2" aria-labelledby="opinie-h">
    <div class="wrap">
      <div class="head rv">
        <div>
          <p class="eyebrow scr">Opinie z Google</p>
          <h2 id="opinie-h" class="h h2 split"><span class="wm"><span class="wi">Klienci</span></span> <span class="wm"><span class="wi">wystawiają</span></span> <span class="wm"><span class="wi">nam</span></span> <span class="wm"><span class="wi">5,0.</span></span> <span class="wm"><span class="wi">Każdy</span></span> <span class="wm"><span class="wi">z</span></span> <span class="wm"><span class="wi">nich.</span></span></h2>
        </div>
        <a href="https://www.google.com/maps?cid=17658555967614608154" target="_blank" rel="noopener" class="tlink">Wszystkie opinie w Google →</a>
      </div>
      <div class="rev-wrap">
        <div class="rev-sum rv" data-tilt>
          <div style="display: flex; align-items: center; gap: 10px; font-size: 14px; color: #C9D2C6"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.6 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.9a5 5 0 0 1-2.2 3.3v2.7h3.6c2.1-1.9 3.3-4.8 3.3-7.9z"></path><path fill="#34A853" d="M12 23c3 0 5.5-1 7.3-2.7l-3.6-2.7c-1 .7-2.2 1.1-3.7 1.1-2.9 0-5.3-1.9-6.2-4.5H2.2v2.8A11 11 0 0 0 12 23z"></path><path fill="#FBBC05" d="M5.8 14.2a6.6 6.6 0 0 1 0-4.3V7.1H2.2a11 11 0 0 0 0 9.9z"></path><path fill="#EA4335" d="M12 5.4c1.6 0 3.1.6 4.2 1.7l3.2-3.2A11 11 0 0 0 2.2 7.1l3.6 2.8C6.7 7.3 9.1 5.4 12 5.4z"></path></svg>Profil firmy w Google</div>
          <div class="big">5,0</div>
          <div class="stars" role="img" aria-label="5 na 5 gwiazdek">{(home.five ?? []).map((f) => (<Fragment><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18.3 5.5 22l1.7-7.4-5.7-5 7.5-.7z"></path></svg></Fragment>))}</div>
          <div style="font-size: 15px; color: #C9D2C6">na podstawie 20 opinii</div>
          <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 6px">
            {(home.dist ?? []).map((d) => (<Fragment>
              <div style="display: grid; grid-template-columns: 14px 1fr 22px; gap: 10px; align-items: center; font-size: 13px; color: #C9D2C6"><span>{d?.s}</span><div style="height: 8px; border-radius: 999px; background: rgba(255,255,255,.1)"><div class="bar" style={d?.style}></div></div><span>{d?.c}</span></div>
            </Fragment>))}
          </div>
          <a href="https://www.google.com/maps?cid=17658555967614608154" target="_blank" rel="noopener" class="btn btn-g" style="margin-top: auto">Wystaw nam opinię</a>
        </div>
        <div class="rev-rows rv d1">
          {(home.reviewRows ?? []).map((row) => (<Fragment>
            <div class={`rev-track ${row?.cls ?? ''}`}>
              {(row?.items ?? []).map((rv) => (<Fragment>
                <figure class="card rev-card">
                  <div class="rev-who"><span class="rev-av" style={`background: ${rv?.color ?? ''}`}>{rv?.ini}</span><div><b>{rv?.name}</b><span>{rv?.meta} · {rv?.when}</span></div></div>
                  <div class="stars" style="margin-top: 10px" role="img" aria-label="5 gwiazdek"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18.3 5.5 22l1.7-7.4-5.7-5 7.5-.7z"></path></svg><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18.3 5.5 22l1.7-7.4-5.7-5 7.5-.7z"></path></svg><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18.3 5.5 22l1.7-7.4-5.7-5 7.5-.7z"></path></svg><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18.3 5.5 22l1.7-7.4-5.7-5 7.5-.7z"></path></svg><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18.3 5.5 22l1.7-7.4-5.7-5 7.5-.7z"></path></svg></div>
                  <p>{rv?.text}</p>
                  {rv?.hasReply && (<Fragment><div class="rev-reply"><strong class="ink">Odpowiedź właściciela:</strong> {rv?.reply}</div></Fragment>)}
                </figure>
              </Fragment>))}
            </div>
          </Fragment>))}
        </div>
      </div>
    </div>
  </section>

  <section class="sec alt" aria-labelledby="pz-who">
    <div class="wrap pz-split">
      <div class="rv">
        <p class="eyebrow scr">Kto prowadzi Twój projekt</p>
        <h2 id="pz-who" class="h h2 split">Kamil Piech, założyciel top.strony</h2>
        <p class="lead">{c.whoLead}</p>
        <p class="lead">Ukończyłem kursy z certyfikatem u Karola Dziedzica, Daniela Bossa, WhitePress i Senuto.</p>
        <a href={AUTHOR.linkedin} class="tlink" rel="noopener" target="_blank">Profil na LinkedIn →</a>
      </div>
      <div class="pz-quote rv d1">
        <img src="/img/kamil-piech-face2.webp" alt="Kamil Piech" width="96" height="96" loading="lazy" decoding="async">
        <div><p>„Strona ma przynosić telefony. Jeśli tego nie robi, szukamy przyczyny razem.”</p><small>Kamil Piech · top.strony, Piaseczno · aktualizacja: listopad 2026</small></div>
      </div>
    </div>
  </section>

  <section id="faq" class="sec" aria-labelledby="pz-faq">
    <div class="wrap pz-faq-wrap">
      <p class="eyebrow scr">FAQ</p>
      <h2 id="pz-faq" class="h h2 split">Pytania o strony internetowe w {c.loc}</h2>
      <div class="sv-faq rv">
        {faqs.map((f, i) => (<details class="sv-fq" open={i === 0}><summary><h3 class="h">{f.q}</h3><span class="sv-fq-i" aria-hidden="true"></span></summary><p>{f.a}</p></details>))}
      </div>
    </div>
  </section>

  <section id="kontakt" class="sec alt" aria-labelledby="pz-cta">
    <div class="wrap pz-contact">
      <div class="pz-cta-box rv">
        <img src="/img/konsultantka-zaproszenie.webp" alt="Doradczyni top.strony zaprasza na bezpłatną konsultację" width="725" height="1000" loading="lazy" decoding="async">
        <div class="pz-cta-tx">
          <p class="pz-k pz-k-w">Bezpłatna konsultacja · 20 min</p>
          <h2 id="pz-cta" class="h">Porozmawiajmy o Twojej stronie</h2>
          <p>Wycenę dostaniesz w 24 godziny, bez zobowiązań.</p>
          <a href="tel:+48501784882" class="pz-wbtn">Zadzwoń: 501 784 882</a>
        </div>
      </div>
      <div class="pz-nap-box rv d1">
